# Copy to .env and change the password. .env is never committed.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=retail_erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retail_erp
# Host port for the database. 5432 is the PostgreSQL default; use another
# port if something else on this machine already listens on 5432.
POSTGRES_PORT=5442

# API (apps/api). Must match the database settings above.
DATABASE_URL=postgresql://retail_erp:change-me@localhost:5442/retail_erp?schema=public
API_PORT=4000
# Browser origin(s) allowed to call the API, comma-separated.
WEB_ORIGIN=http://localhost:3000
# Set to true on the server, where the API is served over HTTPS (session cookie
# is then only sent over HTTPS). Leave false for http://localhost development.
COOKIE_SECURE=false
