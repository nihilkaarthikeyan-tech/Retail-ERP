  isReturn        Boolean            @default(false)
  returnOfId      String?            @db.Uuid
  /// Set when a bill that also receives the goods made this receipt.
  billId          String?            @db.Uuid
  taxableAmount   Decimal            @default(0) @db.Decimal(16, 2)
  taxAmount       Decimal            @default(0) @db.Decimal(16, 2)
  total           Decimal            @default(0) @db.Decimal(16, 2)
  /// Value that went into stock (accepted + rejected, after charges).
  stockValue      Decimal            @default(0) @db.Decimal(16, 2)
  billedPercent   Decimal            @default(0) @db.Decimal(5, 2)
  returnedPercent Decimal            @default(0) @db.Decimal(5, 2)
