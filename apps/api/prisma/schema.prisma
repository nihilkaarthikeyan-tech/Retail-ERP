  /// Decision 31: receipts without an order are allowed (with a reason) unless this is on.
  requireOrderForReceipt Boolean @default(false)
  /// Plan 11 A8: a supplier bill for goods needs a purchase order / a goods receipt, unless the supplier's exception allows it.
  billNeedsOrder         Boolean @default(false)
  billNeedsReceipt       Boolean @default(false)
  overOrderPercent       Decimal @default(0) @db.Decimal(5, 2)
  overReceiptPercent     Decimal @default(0) @db.Decimal(5, 2)
  overBillingPercent     Decimal @default(0) @db.Decimal(5, 2)
  /// allow, warn or block (plan 05 answer 4: warn).
  priceMismatch          String  @default("warn")
  checkSupplierBillNo    Boolean @default(true)
  /// Decision 69 / plan 05 answer 3: ₹50,000.
  approvalLimit          Decimal @default(50000) @db.Decimal(16, 2)
  fillLastPurchasePrice  Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// Module 6 — Point of sale (plan 06 and pos-offline-and-devices). Stock leaves
// at every sale (decision 39); values and account roles are stored for the
// day-end summary that module 7 posts. GST rates come from the HSN rate list
// and apply as soon as they are saved (owner decision of 22 Oct 2026).
// ---------------------------------------------------------------------------

enum PaymentKind {
  cash
  card
  upi
  other
  /// Customer pays later (module 7 plan section 1a, decision 22).
  on_account
}

enum ShiftStatus {
  open
  closed
  cancelled
}

enum PosBillKind {
  sale
  return
}

enum PosBillStatus {
  completed
  cancelled
}

/// Decision 56: effective-dated HSN rate list. Since 22 Oct 2026 a rate applies as soon as it is saved
/// and may be edited (audit history); approvedAt/approvedById are kept only as history.
model GstRate {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId     String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id            String    @id @default(uuid()) @db.Uuid
  hsnCode       String
  rate          Decimal   @db.Decimal(5, 2)
  cessRate      Decimal   @default(0) @db.Decimal(5, 2)
  /// Plan 08 G2: taxable, exempt or nil (exempt and nil are reported apart from 0%).
  kind          String    @default("taxable")
  /// Plan 08 G2: the rate applies when the selling price per unit (GST included) is within this band.
  priceFrom     Decimal?  @db.Decimal(16, 2)
  priceUpTo     Decimal?  @db.Decimal(16, 2)
  effectiveFrom DateTime  @db.Date
  approvedById  String?   @db.Uuid
  approvedAt    DateTime?
  note          String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([companyId, hsnCode, effectiveFrom, priceFrom])
  /// PostgreSQL treats nulls as different, so this stops two plain (no price band) rates on one date.
  @@unique([companyId, hsnCode, effectiveFrom], where: raw("\"priceFrom\" IS NULL"), map: "GstRate_hsn_date_no_band_key")
  @@index([hsnCode])
  @@index([companyId])
}

