// Database schema. Change it only through `pnpm --filter api prisma migrate dev`
// and commit the generated migration in prisma/migrations.
// Module 1: users, roles, permissions, company, stores, financial years,
// document numbering, sessions and audit history (docs/plans/01-users-company-stores.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Company and stores
// ---------------------------------------------------------------------------

model Company {
  id                     String   @id @default(uuid()) @db.Uuid
  code                   String   @unique
  legalName              String
  tradeName              String?
  pan                    String?
  stateCode              String
  addressLine1           String?
  addressLine2           String?
  city                   String?
  pincode                String?
  phone                  String?
  email                  String?
  logo                   Bytes?
  logoMimeType           String?
  homeCurrency           String   @default("INR")
  fiscalYearStartMonth   Int      @default(4)
  /// Set by the accounting module; nothing is dated on or before it.
  lockDate               DateTime? @db.Date
  active                 Boolean  @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  gstRegistrations  GstRegistration[]
  stores            Store[]
  financialYears    FinancialYear[]
  numberSeries      NumberSeries[]
  priceLists        PriceList[]
  catalogueSettings CatalogueSettings?
  customers         Customer[]
  suppliers         Supplier[]
  partySettings     PartySettings?
}

model GstRegistration {
  id                     String  @id @default(uuid()) @db.Uuid
  companyId              String  @db.Uuid
  gstin                  String  @unique
  stateCode              String
  legalNameOnCertificate String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  pincode                String?
  isDefault              Boolean @default(false)
  active                 Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  stores  Store[]

  @@index([companyId])
}

model Store {
  id                String  @id @default(uuid()) @db.Uuid
  companyId         String  @db.Uuid
  code              String
  name              String
  addressLine1      String?
  addressLine2      String?
  city              String?
  pincode           String?
  stateCode         String?
  phone             String?
  email             String?
  gstRegistrationId String? @db.Uuid
  active            Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id])
  gstRegistration GstRegistration? @relation(fields: [gstRegistrationId], references: [id])
  userStores      UserStore[]
  numberSeries    NumberSeries[]

  @@unique([companyId, code])
}

enum FinancialYearStatus {
  open
  locked
}

model FinancialYear {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  name                 String
  startDate            DateTime            @db.Date
  endDate              DateTime            @db.Date
  /// A short or long first/bridging year that is not exactly twelve months.
  isIrregular          Boolean             @default(false)
  status               FinancialYearStatus @default(open)
  createdAutomatically Boolean             @default(false)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId, startDate])
}

// ---------------------------------------------------------------------------
// Document numbering
// ---------------------------------------------------------------------------

model NumberSeries {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  documentKind  String
  /// Prefix pattern with tokens, e.g. "INV-{STORE}-{FY}-".
  pattern       String
  counterLength Int     @default(5)
  /// Null = applies to every store without its own series.
  storeId       String? @db.Uuid
  active        Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company  Company               @relation(fields: [companyId], references: [id])
  store    Store?                @relation(fields: [storeId], references: [id])
  counters NumberSeriesCounter[]

  @@unique([companyId, documentKind, storeId])
}

/// One running number per filled-in prefix; locked row-by-row when allocating.
model NumberSeriesCounter {
  id             String @id @default(uuid()) @db.Uuid
  numberSeriesId String @db.Uuid
  filledPrefix   String
  nextNumber     Int    @default(1)

  updatedAt DateTime @updatedAt

  numberSeries NumberSeries @relation(fields: [numberSeriesId], references: [id])

  @@unique([numberSeriesId, filledPrefix])
}

// ---------------------------------------------------------------------------
// Users, roles, sessions
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  firstName          String
  lastName           String?
  mobile             String?
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime  @default(now())
  active             Boolean   @default(true)
  /// True = may work in every store; otherwise limited to UserStore rows.
  allStores          Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  roles    UserRole[]
  stores   UserStore[]
  sessions Session[]
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// Seeded roles cannot be deleted or renamed in code; their permissions can be edited.
  isSystem    Boolean @default(false)
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserStore {
  userId    String  @db.Uuid
  storeId   String  @db.Uuid
  isDefault Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-row table of security settings.
model SecuritySettings {
  id                   Int     @id @default(1)
  minPasswordLength    Int     @default(10)
  lockoutAttempts      Int     @default(5)
  lockoutSeconds       Int     @default(900)
  sessionIdleMinutes   Int     @default(30)
  sessionMaxHours      Int     @default(12)
  singleSessionPerUser Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// History (append-only; UPDATE and DELETE are refused by a database trigger
// created in the migration)
// ---------------------------------------------------------------------------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// { field: { old, new } } for changes; free-form details for other actions.
  changes    Json?
  reason     String?
  ipAddress  String?

  @@index([entityType, entityId])
  @@index([userId, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Module 2: catalogue (docs/plans/02-items-units-barcodes-price-lists.md)
// Units, groups, brands, HSN codes and attributes are shared by all companies;
// price lists and catalogue settings belong to a company.
// ---------------------------------------------------------------------------

enum UnitKind {
  count
  weight
  length
  volume
  other
}

model Unit {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  kind            UnitKind
  /// Decision 11: may be true only for weight, length and volume.
  allowsFractions Boolean  @default(false)
  active          Boolean  @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  conversionsFrom UnitConversion[] @relation("fromUnit")
  conversionsTo   UnitConversion[] @relation("toUnit")
  itemsAsBase     Item[]
  itemUnits       ItemUnit[]
  barcodes        Barcode[]
  prices          Price[]
}

/// Standard conversion stored once: 1 fromUnit = factor toUnit (1 KG = 1000 G).
model UnitConversion {
  id         String  @id @default(uuid()) @db.Uuid
  fromUnitId String  @db.Uuid
  toUnitId   String  @db.Uuid
  factor     Decimal @db.Decimal(18, 6)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  fromUnit Unit @relation("fromUnit", fields: [fromUnitId], references: [id])
  toUnit   Unit @relation("toUnit", fields: [toUnitId], references: [id])

  @@unique([fromUnitId, toUnitId])
}

model ItemGroup {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  code     String  @unique
  name     String
  /// "/id-of-root/id-of-child/" for subtree queries.
  path     String
  depth    Int     @default(0)
  hsnCode  String?
  active   Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent   ItemGroup?  @relation("groupTree", fields: [parentId], references: [id])
  children ItemGroup[] @relation("groupTree")
  items    Item[]

  @@index([path])
}

model Brand {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  active Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  items Item[]
}

/// HSN (goods) and SAC (services) codes; the GST rate per code comes with the GST module.
model HsnCode {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String
  isService   Boolean @default(false)
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

enum AttributeKind {
  list
  numeric
}

model VariantAttribute {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique
  name       String
  kind       AttributeKind @default(list)
  rangeStart Decimal?      @db.Decimal(12, 4)
  rangeEnd   Decimal?      @db.Decimal(12, 4)
  rangeStep  Decimal?      @db.Decimal(12, 4)
  active     Boolean       @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  values         VariantAttributeValue[]
  itemAttributes ItemVariantAttribute[]
  itemValues     ItemVariantValue[]
}

model VariantAttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @db.Uuid
  value       String
  /// Lower-cased value for case-insensitive uniqueness.
  valueKey    String
  shortCode   String
  sortOrder   Int    @default(0)

  attribute VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, valueKey])
  @@unique([attributeId, shortCode])
}

enum BarcodeType {
  EAN13
  EAN8
  UPCA
  CODE39
  other
}

model Item {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String    @unique
  name                String
  description         String?
  image               Bytes?
  imageMimeType       String?
  itemGroupId         String    @db.Uuid
  brandId             String?   @db.Uuid
  baseUnitId          String    @db.Uuid
  hsnCode             String?
  /// Per basic unit (decision 76). Pack MRPs are on ItemUnit.
  mrp                 Decimal?  @db.Decimal(14, 2)
  maxDiscountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  isStockItem         Boolean   @default(true)
  canBuy              Boolean   @default(true)
  canSell             Boolean   @default(true)
  endDate             DateTime? @db.Date
  active              Boolean   @default(true)
  /// A style that only groups its variants; never stocked, priced or sold.
  isParentStyle       Boolean   @default(false)
  parentItemId        String?   @db.Uuid
  /// Sorted "attributeId=value|…" of a variant, unique within its parent.
  variantKey          String?
  trackBatches        Boolean   @default(false)
  autoNumberBatches   Boolean   @default(false)
  shelfLifeDays       Int?
  trackSerials        Boolean   @default(false)
  warrantyDays        Int?
  /// Per basic unit, filled by purchasing (module 5). Hidden without cost_price.view.
  lastPurchasePrice   Decimal?  @db.Decimal(16, 4)
  /// Filled by module 3 (suppliers).
  preferredSupplierId String?   @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  itemGroup         ItemGroup              @relation(fields: [itemGroupId], references: [id])
  brand             Brand?                 @relation(fields: [brandId], references: [id])
  baseUnit          Unit                   @relation(fields: [baseUnitId], references: [id])
  parent            Item?                  @relation("variants", fields: [parentItemId], references: [id])
  variants          Item[]                 @relation("variants")
  units             ItemUnit[]
  barcodes          Barcode[]
  variantAttributes ItemVariantAttribute[]
  variantValues     ItemVariantValue[]
  prices            Price[]
  preferredSupplier Supplier?              @relation(fields: [preferredSupplierId], references: [id])

  @@unique([parentItemId, variantKey])
  @@index([name])
  @@index([itemGroupId])
}

/// Units an item is bought or sold in. The basic unit row always has factor 1.
model ItemUnit {
  id     String   @id @default(uuid()) @db.Uuid
  itemId String   @db.Uuid
  unitId String   @db.Uuid
  /// Basic units in one of this unit (BOX = 12 PCS → 12).
  factor Decimal  @db.Decimal(18, 6)
  mrp    Decimal? @db.Decimal(14, 2)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, unitId])
}

model Barcode {
  id     String      @id @default(uuid()) @db.Uuid
  code   String      @unique
  itemId String      @db.Uuid
  unitId String?     @db.Uuid
  type   BarcodeType @default(other)
  active Boolean     @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id])
}

/// Which attributes a style varies by.
model ItemVariantAttribute {
  itemId      String @db.Uuid
  attributeId String @db.Uuid
  sortOrder   Int    @default(0)

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute VariantAttribute @relation(fields: [attributeId], references: [id])

  @@id([itemId, attributeId])
}

/// A variant's value for each of its parent's attributes.
model ItemVariantValue {
  itemId      String @db.Uuid
  attributeId String @db.Uuid
  value       String
  shortCode   String

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute VariantAttribute @relation(fields: [attributeId], references: [id])

  @@id([itemId, attributeId])
}

model PriceList {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  code          String
  name          String
  forSelling    Boolean @default(true)
  forBuying     Boolean @default(false)
  currency      String  @default("INR")
  /// false = prices are per basic unit and other units are worked out by factor.
  pricesPerUnit Boolean @default(false)
  active        Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company        Company         @relation(fields: [companyId], references: [id])
  prices         Price[]
  customerGroups CustomerGroup[]
  customers      Customer[]
  supplierGroups SupplierGroup[]
  suppliers      Supplier[]

  @@unique([companyId, code])
}

model Price {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @db.Uuid
  itemId      String    @db.Uuid
  unitId      String    @db.Uuid
  price       Decimal   @db.Decimal(16, 4)
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  packSize    Decimal?  @db.Decimal(18, 6)
  /// Set by module 3 (customers/suppliers) and module 4 (batches); plain ids until then.
  customerId  String?   @db.Uuid
  supplierId  String?   @db.Uuid
  batchId     String?   @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  priceList PriceList @relation(fields: [priceListId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  unit      Unit      @relation(fields: [unitId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@index([priceListId, itemId])
  @@index([itemId])
}

/// One row per company.
model CatalogueSettings {
  companyId                    String  @id @db.Uuid
  autoItemCodes                Boolean @default(true)
  defaultItemGroupId           String? @db.Uuid
  defaultUnitId                String? @db.Uuid
  defaultSellingPriceListId    String? @db.Uuid
  defaultBuyingPriceListId     String? @db.Uuid
  fallbackToDefaultSellingList Boolean @default(true)
  allowPriceChangeOnBill       Boolean @default(false)
  blockSellingBelowCost        Boolean @default(false)
  saveTypedPrices              Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
}

// ---------------------------------------------------------------------------
// Module 3: customers and suppliers (docs/plans/03-customers-suppliers.md)
// ---------------------------------------------------------------------------

enum PartyType {
  customer
  supplier
}

enum PartyStatus {
  active
  blocked
  off
}

enum HoldType {
  none
  bills
  payments
  all
}

enum DueBasis {
  days_after_date
  days_after_month_end
  months_then_month_end
}

/// Postal address of a customer or supplier. GSTIN per address (decision 21).
model Address {
  id           String    @id @default(uuid()) @db.Uuid
  partyType    PartyType
  partyId      String    @db.Uuid
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  stateCode    String
  pincode      String?
  phone        String?
  email        String?
  gstin        String?
  isBilling    Boolean   @default(true)
  isDelivery   Boolean   @default(true)
  isMain       Boolean   @default(false)
  active       Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([partyType, partyId])
}

model ContactPerson {
  id           String    @id @default(uuid()) @db.Uuid
  partyType    PartyType
  partyId      String    @db.Uuid
  name         String
  jobTitle     String?
  email        String?
  mobile       String?
  isMain       Boolean   @default(false)
  /// Decision 74: consent for promotional messages.
  noPromotions Boolean   @default(false)
  active       Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([partyType, partyId])
}

model PaymentTerms {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  active Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parts          PaymentTermsPart[]
  customerGroups CustomerGroup[]
  customers      Customer[]
  supplierGroups SupplierGroup[]
  suppliers      Supplier[]
}

model PaymentTermsPart {
  id                   String   @id @default(uuid()) @db.Uuid
  paymentTermsId       String   @db.Uuid
  sortOrder            Int      @default(0)
  share                Decimal  @db.Decimal(5, 2)
  dueBasis             DueBasis
  days                 Int      @default(0)
  months               Int      @default(0)
  earlyDiscountPercent Decimal? @db.Decimal(5, 2)
  earlyDiscountDays    Int?

  paymentTerms PaymentTerms @relation(fields: [paymentTermsId], references: [id], onDelete: Cascade)
}

model CustomerGroup {
  id              String  @id @default(uuid()) @db.Uuid
  parentId        String? @db.Uuid
  code            String  @unique
  name            String
  path            String
  depth           Int     @default(0)
  priceListId     String? @db.Uuid
  paymentTermsId  String? @db.Uuid
  creditLimit     Decimal @default(0) @db.Decimal(14, 2)
  overdueLimit    Decimal @default(0) @db.Decimal(14, 2)
  skipCreditCheck Boolean @default(false)
  active          Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent       CustomerGroup?  @relation("customerGroupTree", fields: [parentId], references: [id])
  children     CustomerGroup[] @relation("customerGroupTree")
  priceList    PriceList?      @relation(fields: [priceListId], references: [id])
  paymentTerms PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  customers    Customer[]
}

model Customer {
  id                    String      @id @default(uuid()) @db.Uuid
  companyId             String      @db.Uuid
  code                  String      @unique
  name                  String
  isBusiness            Boolean     @default(false)
  mobile                String?
  email                 String?
  notes                 String?
  customerGroupId       String      @db.Uuid
  gstin                 String?
  stateCode             String?
  priceListId           String?     @db.Uuid
  paymentTermsId        String?     @db.Uuid
  /// 0 = no credit (decision 22).
  creditLimit           Decimal     @default(0) @db.Decimal(14, 2)
  overdueLimit          Decimal     @default(0) @db.Decimal(14, 2)
  creditCheckAtDelivery Boolean     @default(false)
  status                PartyStatus @default(active)
  isWalkIn              Boolean     @default(false)
  linkedSupplierId      String?     @db.Uuid
  /// Temporary number given by an offline till (module 6).
  offlineTillRef        String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company        Company        @relation(fields: [companyId], references: [id])
  customerGroup  CustomerGroup  @relation(fields: [customerGroupId], references: [id])
  priceList      PriceList?     @relation(fields: [priceListId], references: [id])
  paymentTerms   PaymentTerms?  @relation(fields: [paymentTermsId], references: [id])
  linkedSupplier Supplier?      @relation("customerSupplierLink", fields: [linkedSupplierId], references: [id])
  prices         Price[]

  @@index([mobile])
  @@index([name])
}

model SupplierGroup {
  id             String  @id @default(uuid()) @db.Uuid
  parentId       String? @db.Uuid
  code           String  @unique
  name           String
  path           String
  depth          Int     @default(0)
  priceListId    String? @db.Uuid
  paymentTermsId String? @db.Uuid
  active         Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent       SupplierGroup?  @relation("supplierGroupTree", fields: [parentId], references: [id])
  children     SupplierGroup[] @relation("supplierGroupTree")
  priceList    PriceList?      @relation(fields: [priceListId], references: [id])
  paymentTerms PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  suppliers    Supplier[]
}

model Supplier {
  id                      String      @id @default(uuid()) @db.Uuid
  companyId               String      @db.Uuid
  code                    String      @unique
  name                    String
  isBusiness              Boolean     @default(true)
  mobile                  String?
  email                   String?
  notes                   String?
  supplierGroupId         String      @db.Uuid
  isTransporter           Boolean     @default(false)
  gstin                   String?
  pan                     String?
  stateCode               String?
  priceListId             String?     @db.Uuid
  paymentTermsId          String?     @db.Uuid
  bankAccountNote         String?
  status                  PartyStatus @default(active)
  holdType                HoldType    @default(none)
  holdUntil               DateTime?   @db.Date
  holdReason              String?
  allowBillWithoutOrder   Boolean     @default(false)
  allowBillWithoutReceipt Boolean     @default(false)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company         Company       @relation(fields: [companyId], references: [id])
  supplierGroup   SupplierGroup @relation(fields: [supplierGroupId], references: [id])
  priceList       PriceList?    @relation(fields: [priceListId], references: [id])
  paymentTerms    PaymentTerms? @relation(fields: [paymentTermsId], references: [id])
  linkedCustomers Customer[]    @relation("customerSupplierLink")
  prices          Price[]
  preferredForItems Item[]

  @@index([name])
}

/// One row per company.
model PartySettings {
  companyId              String  @id @db.Uuid
  defaultCustomerGroupId String? @db.Uuid
  defaultSupplierGroupId String? @db.Uuid
  defaultPaymentTermsId  String? @db.Uuid
  defaultCreditLimit     Decimal @default(0) @db.Decimal(14, 2)
  walkInCustomerId       String? @db.Uuid
  gstTreatmentFrom       String  @default("billing")

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
}
