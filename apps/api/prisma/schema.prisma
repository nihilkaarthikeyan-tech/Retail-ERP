/// One row per company.
model InventorySettings {
  companyId           String    @id @db.Uuid
  /// Month-end lock (decision 36): nothing on or before this date.
  stockLockDate       DateTime? @db.Date
  /// Decision 32: the till may sell below zero (flagged); used by module 6.
  allowNegativeAtTill Boolean   @default(true)
  batchPickOrder      String    @default("earliest_expiry")
  transitLocationId   String?   @db.Uuid

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// Module 5 — Purchasing (plan 05). Values and account roles are stored on the
// lines; module 7 posts them to the books (plan 05 answer 1). GST is recorded
// as stated on the supplier's document (answer 2). Rupees only (answer 6).
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  draft
  to_receive_and_bill
  to_receive
  to_bill
  completed
  on_hold
  closed
  cancelled
}

enum GoodsReceiptStatus {
  draft
  to_bill
  partly_billed
  completed
  returned
  closed
  cancelled
}

enum SupplierBillStatus {
  draft
  unpaid
  cancelled
}

enum SupplierBillKind {
  against_receipt
  receives_goods
  services
  debit_note
}

enum PurchaseDocStatus {
  draft
  finalised
  cancelled
}

model PurchaseOrder {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  number             String
  supplierId         String               @db.Uuid
  /// Indian business dates (rule 15).
  orderDate          DateTime             @db.Date
  neededBy           DateTime             @db.Date
  storeId            String               @db.Uuid
  supplierQuoteRef   String?
  paymentTermsId     String?              @db.Uuid
