/// What each business sets for GST; in force as soon as it is saved (owner decision of 22 Oct 2026).
/// approvedAt, approvedById and approvalNote are kept only as history of the old approval step.
model GstSettings {
  companyId              String    @id @db.Uuid
  /// regular or composition.
  scheme                 String    @default("regular")
  /// monthly or quarterly.
  filingFrequency        String    @default("quarterly")
  /// Aggregate annual turnover band: up_to_5cr, 5cr_to_10cr, above_10cr, above_500cr.
  turnoverBand           String    @default("up_to_5cr")
  /// HSN digits printed and reported: 4, 6 or 8.
  hsnDigits              Int       @default(4)
  eInvoiceApplies        Boolean   @default(false)
  /// Show sales under ₹200 with no invoice wanted as one combined daily invoice in the reports.
  combineSmallSales      Boolean   @default(true)
  /// How free samples are taxed (decision 61).
  freeSampleTax          String    @default("not_set")
  receiptTaxTable        Boolean   @default(true)
  eWayLimit              Decimal   @default(50000) @db.Decimal(16, 2)
  /// Same-state e-way bill limits by state code, where a state sets its own.
  eWayStateLimits        Json      @default("{}")
  defaultTransporterId   String?
  defaultTransporterName String?
  approvedAt             DateTime?
  approvedById           String?   @db.Uuid
  approvalNote           String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// An e-invoice for a business invoice or its credit or debit note.
model EInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  gstRegistrationId String    @db.Uuid
  /// pos_bill or supplier_bill (debit notes) …
  documentType      String
  documentId        String    @db.Uuid
  documentNumber    String
  /// waiting, registered, failed or cancelled.
  status            String    @default("waiting")
  irn               String?
  ackNumber         String?
  ackDate           DateTime?
  signedQr          String?
  error             String?
  exportedAt        DateTime?
  registeredAt      DateTime?
  cancelledAt       DateTime?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([documentType, documentId])
  @@index([companyId, status])
}

/// An e-way bill for moving goods.
model EWayBill {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  /// pos_bill, stock_document (transfer) or supplier return …
  documentType    String
  documentId      String    @db.Uuid
  documentNumber  String
  value           Decimal   @db.Decimal(16, 2)
  distanceKm      Int?
  transporterId   String?
  transporterName String?
  vehicleNo       String?
  /// draft, generated, cancelled or expired.
  status          String    @default("draft")
  number          String?
  generatedAt     DateTime?
  validUntil      DateTime?
  error           String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([documentType, documentId])
  @@index([companyId, status])
}

/// A statement downloaded from the GST portal (e.g. the inward statement) and uploaded for matching.
model GstReturnUpload {
  id                String @id @default(uuid()) @db.Uuid
  companyId         String @db.Uuid
