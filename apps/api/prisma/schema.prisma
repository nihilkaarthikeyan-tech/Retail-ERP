// Copyright (c) 2026, Rademics. All rights reserved.
// Database schema. Change it only through `pnpm --filter api prisma migrate dev`
// and commit the generated migration in prisma/migrations.
// Module 1: users, roles, permissions, company, stores, financial years,
// document numbering, sessions and audit history (docs/plans/01-users-company-stores.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Company and stores
// ---------------------------------------------------------------------------

model Company {
  id                   String    @id @default(uuid()) @db.Uuid
  code                 String    @unique
  legalName            String
  tradeName            String?
  pan                  String?
  stateCode            String
  addressLine1         String?
  addressLine2         String?
  city                 String?
  pincode              String?
  phone                String?
  email                String?
  logo                 Bytes?
  logoMimeType         String?
  homeCurrency         String    @default("INR")
  fiscalYearStartMonth Int       @default(4)
  /// Set by the accounting module; nothing is dated on or before it.
  lockDate             DateTime? @db.Date
  active               Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  gstRegistrations  GstRegistration[]
  stores            Store[]
  financialYears    FinancialYear[]
  numberSeries      NumberSeries[]
  priceLists        PriceList[]
  catalogueSettings CatalogueSettings?
  customers         Customer[]
  suppliers         Supplier[]
  partySettings     PartySettings?
  stockLocations    StockLocation[]
}

model GstRegistration {
  id                     String  @id @default(uuid()) @db.Uuid
  companyId              String  @db.Uuid
  gstin                  String  @unique
  stateCode              String
  legalNameOnCertificate String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  pincode                String?
  isDefault              Boolean @default(false)
  active                 Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  stores  Store[]

  @@index([companyId])
}

model Store {
  id                String  @id @default(uuid()) @db.Uuid
  companyId         String  @db.Uuid
  code              String
  name              String
  addressLine1      String?
  addressLine2      String?
  city              String?
  pincode           String?
  stateCode         String?
  phone             String?
  email             String?
  gstRegistrationId String? @db.Uuid
  active            Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id])
  gstRegistration GstRegistration? @relation(fields: [gstRegistrationId], references: [id])
  userStores      UserStore[]
  numberSeries    NumberSeries[]
  stockLocations  StockLocation[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]

  @@unique([companyId, code])
}

enum FinancialYearStatus {
  open
  locked
}

model FinancialYear {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  name                 String
  startDate            DateTime            @db.Date
  endDate              DateTime            @db.Date
  /// A short or long first/bridging year that is not exactly twelve months.
  isIrregular          Boolean             @default(false)
  status               FinancialYearStatus @default(open)
  createdAutomatically Boolean             @default(false)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId, startDate])
}

// ---------------------------------------------------------------------------
// Document numbering
// ---------------------------------------------------------------------------

model NumberSeries {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  documentKind  String
  /// Prefix pattern with tokens, e.g. "INV-{STORE}-{FY}-".
  pattern       String
  counterLength Int     @default(5)
  /// Null = applies to every store without its own series.
  storeId       String? @db.Uuid
  active        Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company  Company               @relation(fields: [companyId], references: [id])
  store    Store?                @relation(fields: [storeId], references: [id])
  counters NumberSeriesCounter[]

  @@unique([companyId, documentKind, storeId])
}

/// One running number per filled-in prefix; locked row-by-row when allocating.
model NumberSeriesCounter {
  id             String @id @default(uuid()) @db.Uuid
  numberSeriesId String @db.Uuid
  filledPrefix   String
  nextNumber     Int    @default(1)

  updatedAt DateTime @updatedAt

  numberSeries NumberSeries @relation(fields: [numberSeriesId], references: [id])

  @@unique([numberSeriesId, filledPrefix])
}

// ---------------------------------------------------------------------------
// Users, roles, sessions
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  firstName          String
  lastName           String?
  mobile             String?
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime  @default(now())
  active             Boolean   @default(true)
  /// True = may work in every store; otherwise limited to UserStore rows.
  allStores          Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  roles    UserRole[]
  stores   UserStore[]
  sessions Session[]
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// Seeded roles cannot be deleted or renamed in code; their permissions can be edited.
  isSystem    Boolean @default(false)
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserStore {
  userId    String  @db.Uuid
  storeId   String  @db.Uuid
  isDefault Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-row table of security settings.
model SecuritySettings {
  id                   Int     @id @default(1)
  minPasswordLength    Int     @default(10)
  lockoutAttempts      Int     @default(5)
  lockoutSeconds       Int     @default(900)
  sessionIdleMinutes   Int     @default(30)
  sessionMaxHours      Int     @default(12)
  singleSessionPerUser Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// History (append-only; UPDATE and DELETE are refused by a database trigger
// created in the migration)
// ---------------------------------------------------------------------------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// { field: { old, new } } for changes; free-form details for other actions.
  changes    Json?
  reason     String?
  ipAddress  String?

  @@index([entityType, entityId])
  @@index([userId, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Module 2: catalogue (docs/plans/02-items-units-barcodes-price-lists.md)
// Units, groups, brands, HSN codes and attributes are shared by all companies;
// price lists and catalogue settings belong to a company.
// ---------------------------------------------------------------------------

enum UnitKind {
  count
  weight
  length
  volume
  other
}

model Unit {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  kind            UnitKind
  /// Decision 11: may be true only for weight, length and volume.
  allowsFractions Boolean  @default(false)
  active          Boolean  @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  conversionsFrom UnitConversion[] @relation("fromUnit")
  conversionsTo   UnitConversion[] @relation("toUnit")
  itemsAsBase     Item[]
  itemUnits       ItemUnit[]
  barcodes        Barcode[]
  prices          Price[]
}

/// Standard conversion stored once: 1 fromUnit = factor toUnit (1 KG = 1000 G).
model UnitConversion {
  id         String  @id @default(uuid()) @db.Uuid
  fromUnitId String  @db.Uuid
  toUnitId   String  @db.Uuid
  factor     Decimal @db.Decimal(18, 6)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  fromUnit Unit @relation("fromUnit", fields: [fromUnitId], references: [id])
  toUnit   Unit @relation("toUnit", fields: [toUnitId], references: [id])

  @@unique([fromUnitId, toUnitId])
}

model ItemGroup {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  code     String  @unique
  name     String
  /// "/id-of-root/id-of-child/" for subtree queries.
  path     String
  depth    Int     @default(0)
  hsnCode  String?
  active   Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent   ItemGroup?  @relation("groupTree", fields: [parentId], references: [id])
  children ItemGroup[] @relation("groupTree")
  items    Item[]

  @@index([path])
}

model Brand {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  active Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  items Item[]
}

/// HSN (goods) and SAC (services) codes; the GST rate per code comes with the GST module.
model HsnCode {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String
  isService   Boolean @default(false)
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

enum AttributeKind {
  list
  numeric
}

model VariantAttribute {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique
  name       String
  kind       AttributeKind @default(list)
  rangeStart Decimal?      @db.Decimal(12, 4)
  rangeEnd   Decimal?      @db.Decimal(12, 4)
  rangeStep  Decimal?      @db.Decimal(12, 4)
  active     Boolean       @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  values         VariantAttributeValue[]
  itemAttributes ItemVariantAttribute[]
  itemValues     ItemVariantValue[]
}

model VariantAttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @db.Uuid
  value       String
  /// Lower-cased value for case-insensitive uniqueness.
  valueKey    String
  shortCode   String
  sortOrder   Int    @default(0)

  attribute VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, valueKey])
  @@unique([attributeId, shortCode])
}

enum BarcodeType {
  EAN13
  EAN8
  UPCA
  CODE39
  other
}

model Item {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String    @unique
  name                String
  description         String?
  image               Bytes?
  imageMimeType       String?
  itemGroupId         String    @db.Uuid
  brandId             String?   @db.Uuid
  baseUnitId          String    @db.Uuid
  hsnCode             String?
  /// Per basic unit (decision 76). Pack MRPs are on ItemUnit.
  mrp                 Decimal?  @db.Decimal(14, 2)
  maxDiscountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  isStockItem         Boolean   @default(true)
  canBuy              Boolean   @default(true)
  canSell             Boolean   @default(true)
  endDate             DateTime? @db.Date
  active              Boolean   @default(true)
  /// A style that only groups its variants; never stocked, priced or sold.
  isParentStyle       Boolean   @default(false)
  parentItemId        String?   @db.Uuid
  /// Sorted "attributeId=value|…" of a variant, unique within its parent.
  variantKey          String?
  trackBatches        Boolean   @default(false)
  autoNumberBatches   Boolean   @default(false)
  shelfLifeDays       Int?
  trackSerials        Boolean   @default(false)
  warrantyDays        Int?
  /// Per basic unit, filled by purchasing (module 5). Hidden without cost_price.view.
  lastPurchasePrice   Decimal?  @db.Decimal(16, 4)
  /// Filled by module 3 (suppliers).
  preferredSupplierId String?   @db.Uuid
  /// Module 5: overrides the company over-receipt / over-billing allowance (percent).
  overReceiptPercent  Decimal?  @db.Decimal(5, 2)
  /// Module 5: smallest total per order, in basic units.
  minOrderQuantity    Decimal?  @db.Decimal(18, 3)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  itemGroup          ItemGroup              @relation(fields: [itemGroupId], references: [id])
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  baseUnit           Unit                   @relation(fields: [baseUnitId], references: [id])
  parent             Item?                  @relation("variants", fields: [parentItemId], references: [id])
  variants           Item[]                 @relation("variants")
  units              ItemUnit[]
  barcodes           Barcode[]
  variantAttributes  ItemVariantAttribute[]
  variantValues      ItemVariantValue[]
  prices             Price[]
  preferredSupplier  Supplier?              @relation(fields: [preferredSupplierId], references: [id])
  stockLines         StockDocumentLine[]
  batches            Batch[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  supplierBillLines  SupplierBillLine[]

  @@unique([parentItemId, variantKey])
  @@index([name])
  @@index([itemGroupId])
}

/// Units an item is bought or sold in. The basic unit row always has factor 1.
model ItemUnit {
  id     String   @id @default(uuid()) @db.Uuid
  itemId String   @db.Uuid
  unitId String   @db.Uuid
  /// Basic units in one of this unit (BOX = 12 PCS → 12).
  factor Decimal  @db.Decimal(18, 6)
  mrp    Decimal? @db.Decimal(14, 2)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, unitId])
}

model Barcode {
  id     String      @id @default(uuid()) @db.Uuid
  code   String      @unique
  itemId String      @db.Uuid
  unitId String?     @db.Uuid
  type   BarcodeType @default(other)
  active Boolean     @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id])
}

/// Which attributes a style varies by.
model ItemVariantAttribute {
  itemId      String @db.Uuid
  attributeId String @db.Uuid
  sortOrder   Int    @default(0)

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute VariantAttribute @relation(fields: [attributeId], references: [id])

  @@id([itemId, attributeId])
}

/// A variant's value for each of its parent's attributes.
model ItemVariantValue {
  itemId      String @db.Uuid
  attributeId String @db.Uuid
  value       String
  shortCode   String

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute VariantAttribute @relation(fields: [attributeId], references: [id])

  @@id([itemId, attributeId])
}

model PriceList {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  code          String
  name          String
  forSelling    Boolean @default(true)
  forBuying     Boolean @default(false)
  currency      String  @default("INR")
  /// false = prices are per basic unit and other units are worked out by factor.
  pricesPerUnit Boolean @default(false)
  active        Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company        Company         @relation(fields: [companyId], references: [id])
  prices         Price[]
  customerGroups CustomerGroup[]
  customers      Customer[]
  supplierGroups SupplierGroup[]
  suppliers      Supplier[]

  @@unique([companyId, code])
}

model Price {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @db.Uuid
  itemId      String    @db.Uuid
  unitId      String    @db.Uuid
  price       Decimal   @db.Decimal(16, 4)
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  packSize    Decimal?  @db.Decimal(18, 6)
  /// Set by module 3 (customers/suppliers) and module 4 (batches); plain ids until then.
  customerId  String?   @db.Uuid
  supplierId  String?   @db.Uuid
  batchId     String?   @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  priceList PriceList @relation(fields: [priceListId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  unit      Unit      @relation(fields: [unitId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@index([priceListId, itemId])
  @@index([itemId])
}

/// One row per company.
model CatalogueSettings {
  companyId                    String  @id @db.Uuid
  autoItemCodes                Boolean @default(true)
  defaultItemGroupId           String? @db.Uuid
  defaultUnitId                String? @db.Uuid
  defaultSellingPriceListId    String? @db.Uuid
  defaultBuyingPriceListId     String? @db.Uuid
  fallbackToDefaultSellingList Boolean @default(true)
  allowPriceChangeOnBill       Boolean @default(false)
  blockSellingBelowCost        Boolean @default(false)
  saveTypedPrices              Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
}

// ---------------------------------------------------------------------------
// Module 3: customers and suppliers (docs/plans/03-customers-suppliers.md)
// ---------------------------------------------------------------------------

enum PartyType {
  customer
  supplier
}

enum PartyStatus {
  active
  blocked
  off
}

enum HoldType {
  none
  bills
  payments
  all
}

enum DueBasis {
  days_after_date
  days_after_month_end
  months_then_month_end
}

/// Postal address of a customer or supplier. GSTIN per address (decision 21).
model Address {
  id           String    @id @default(uuid()) @db.Uuid
  partyType    PartyType
  partyId      String    @db.Uuid
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  stateCode    String
  pincode      String?
  phone        String?
  email        String?
  gstin        String?
  isBilling    Boolean   @default(true)
  isDelivery   Boolean   @default(true)
  isMain       Boolean   @default(false)
  active       Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([partyType, partyId])
}

model ContactPerson {
  id           String    @id @default(uuid()) @db.Uuid
  partyType    PartyType
  partyId      String    @db.Uuid
  name         String
  jobTitle     String?
  email        String?
  mobile       String?
  isMain       Boolean   @default(false)
  /// Decision 74: consent for promotional messages.
  noPromotions Boolean   @default(false)
  active       Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([partyType, partyId])
}

model PaymentTerms {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  active Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parts          PaymentTermsPart[]
  customerGroups CustomerGroup[]
  customers      Customer[]
  supplierGroups SupplierGroup[]
  suppliers      Supplier[]
}

model PaymentTermsPart {
  id                   String   @id @default(uuid()) @db.Uuid
  paymentTermsId       String   @db.Uuid
  sortOrder            Int      @default(0)
  share                Decimal  @db.Decimal(5, 2)
  dueBasis             DueBasis
  days                 Int      @default(0)
  months               Int      @default(0)
  earlyDiscountPercent Decimal? @db.Decimal(5, 2)
  earlyDiscountDays    Int?

  paymentTerms PaymentTerms @relation(fields: [paymentTermsId], references: [id], onDelete: Cascade)
}

model CustomerGroup {
  id              String  @id @default(uuid()) @db.Uuid
  parentId        String? @db.Uuid
  code            String  @unique
  name            String
  path            String
  depth           Int     @default(0)
  priceListId     String? @db.Uuid
  paymentTermsId  String? @db.Uuid
  creditLimit     Decimal @default(0) @db.Decimal(14, 2)
  overdueLimit    Decimal @default(0) @db.Decimal(14, 2)
  skipCreditCheck Boolean @default(false)
  active          Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent       CustomerGroup?  @relation("customerGroupTree", fields: [parentId], references: [id])
  children     CustomerGroup[] @relation("customerGroupTree")
  priceList    PriceList?      @relation(fields: [priceListId], references: [id])
  paymentTerms PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  customers    Customer[]
}

model Customer {
  id                    String      @id @default(uuid()) @db.Uuid
  companyId             String      @db.Uuid
  code                  String      @unique
  name                  String
  isBusiness            Boolean     @default(false)
  mobile                String?
  email                 String?
  notes                 String?
  customerGroupId       String      @db.Uuid
  gstin                 String?
  stateCode             String?
  priceListId           String?     @db.Uuid
  paymentTermsId        String?     @db.Uuid
  /// 0 = no credit (decision 22).
  creditLimit           Decimal     @default(0) @db.Decimal(14, 2)
  overdueLimit          Decimal     @default(0) @db.Decimal(14, 2)
  creditCheckAtDelivery Boolean     @default(false)
  status                PartyStatus @default(active)
  isWalkIn              Boolean     @default(false)
  linkedSupplierId      String?     @db.Uuid
  /// Temporary number given by an offline till (module 6).
  offlineTillRef        String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company        Company       @relation(fields: [companyId], references: [id])
  customerGroup  CustomerGroup @relation(fields: [customerGroupId], references: [id])
  priceList      PriceList?    @relation(fields: [priceListId], references: [id])
  paymentTerms   PaymentTerms? @relation(fields: [paymentTermsId], references: [id])
  linkedSupplier Supplier?     @relation("customerSupplierLink", fields: [linkedSupplierId], references: [id])
  prices         Price[]

  @@index([mobile])
  @@index([name])
}

model SupplierGroup {
  id             String  @id @default(uuid()) @db.Uuid
  parentId       String? @db.Uuid
  code           String  @unique
  name           String
  path           String
  depth          Int     @default(0)
  priceListId    String? @db.Uuid
  paymentTermsId String? @db.Uuid
  active         Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent       SupplierGroup?  @relation("supplierGroupTree", fields: [parentId], references: [id])
  children     SupplierGroup[] @relation("supplierGroupTree")
  priceList    PriceList?      @relation(fields: [priceListId], references: [id])
  paymentTerms PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  suppliers    Supplier[]
}

model Supplier {
  id                      String      @id @default(uuid()) @db.Uuid
  companyId               String      @db.Uuid
  code                    String      @unique
  name                    String
  isBusiness              Boolean     @default(true)
  mobile                  String?
  email                   String?
  notes                   String?
  supplierGroupId         String      @db.Uuid
  isTransporter           Boolean     @default(false)
  gstin                   String?
  pan                     String?
  stateCode               String?
  priceListId             String?     @db.Uuid
  paymentTermsId          String?     @db.Uuid
  bankAccountNote         String?
  status                  PartyStatus @default(active)
  holdType                HoldType    @default(none)
  holdUntil               DateTime?   @db.Date
  holdReason              String?
  allowBillWithoutOrder   Boolean     @default(false)
  allowBillWithoutReceipt Boolean     @default(false)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company           Company         @relation(fields: [companyId], references: [id])
  supplierGroup     SupplierGroup   @relation(fields: [supplierGroupId], references: [id])
  priceList         PriceList?      @relation(fields: [priceListId], references: [id])
  paymentTerms      PaymentTerms?   @relation(fields: [paymentTermsId], references: [id])
  linkedCustomers   Customer[]      @relation("customerSupplierLink")
  prices            Price[]
  preferredForItems Item[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierBills     SupplierBill[]

  @@index([name])
}

/// One row per company.
model PartySettings {
  companyId              String  @id @db.Uuid
  defaultCustomerGroupId String? @db.Uuid
  defaultSupplierGroupId String? @db.Uuid
  defaultPaymentTermsId  String? @db.Uuid
  defaultCreditLimit     Decimal @default(0) @db.Decimal(14, 2)
  walkInCustomerId       String? @db.Uuid
  gstTreatmentFrom       String  @default("billing")

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
}

// ---------------------------------------------------------------------------
// Module 4: inventory (docs/plans/04-inventory.md)
// ---------------------------------------------------------------------------

enum LocationKind {
  folder
  shelf
  transit
  rejected
}

enum StockDocKind {
  stock_in
  stock_out
  move
  transfer_send
  transfer_receive
  count
}

enum StockDocStatus {
  draft
  finalised
  cancelled
}

enum StockEntryKind {
  in
  out
  set
  reverse
}

enum SerialStatus {
  in_stock
  in_transit
  out
}

/// A place stock is counted. Only `shelf`, `transit` and `rejected` locations hold stock.
model StockLocation {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  /// Null only for the company's transit location.
  storeId   String?      @db.Uuid
  parentId  String?      @db.Uuid
  code      String
  name      String
  kind      LocationKind
  active    Boolean      @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company  Company         @relation(fields: [companyId], references: [id])
  store    Store?          @relation(fields: [storeId], references: [id])
  parent   StockLocation?  @relation("locationTree", fields: [parentId], references: [id])
  children StockLocation[] @relation("locationTree")

  @@unique([companyId, code])
  @@index([storeId])
}

model StockDocument {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  number         String         @unique
  kind           StockDocKind
  reason         String?
  /// Counts: opening or normal.
  countType      String?
  blind          Boolean        @default(false)
  status         StockDocStatus @default(draft)
  /// Indian business date (rule 15) and the instant used to order movements.
  postingDate    DateTime       @db.Date
  postingAt      DateTime
  storeId        String         @db.Uuid
  toStoreId      String?        @db.Uuid
  fromLocationId String?        @db.Uuid
  toLocationId   String?        @db.Uuid
  /// A transfer receive points at its send.
  sendDocumentId String?        @db.Uuid
  remarks        String?
  isBackDated    Boolean        @default(false)
  totalValueIn   Decimal        @default(0) @db.Decimal(16, 2)
  totalValueOut  Decimal        @default(0) @db.Decimal(16, 2)
  finalisedAt    DateTime?
  finalisedById  String?        @db.Uuid
  cancelledAt    DateTime?
  cancelledById  String?        @db.Uuid
  cancelReason   String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  lines        StockDocumentLine[]
  sendDocument StockDocument?      @relation("transferPair", fields: [sendDocumentId], references: [id])
  receipts     StockDocument[]     @relation("transferPair")

  @@index([companyId, kind, status])
  @@index([storeId, postingDate])
}

model StockDocumentLine {
  id               String    @id @default(uuid()) @db.Uuid
  documentId       String    @db.Uuid
  lineNo           Int
  itemId           String    @db.Uuid
  unitId           String    @db.Uuid
  /// In the line unit; `basicQuantity` = quantity × factor.
  quantity         Decimal   @db.Decimal(18, 3)
  factor           Decimal   @db.Decimal(18, 6)
  basicQuantity    Decimal   @db.Decimal(18, 3)
  batchId          String?   @db.Uuid
  /// New batch to create on finalising a stock-in (number, dates).
  newBatchNumber   String?
  newManufactureOn DateTime? @db.Date
  newExpiryOn      DateTime? @db.Date
  serialNumbers    String[]
  /// Cost per basic unit given by the user (stock-in, counts).
  unitCost         Decimal?  @db.Decimal(16, 4)
  /// Counts: what the system expected at the count's time.
  expectedQuantity Decimal?  @db.Decimal(18, 3)
  countedQuantity  Decimal?  @db.Decimal(18, 3)
  /// Value moved by this line once finalised (sum of its ledger entries).
  valueChange      Decimal   @default(0) @db.Decimal(16, 2)
  /// Transfer sends: how much has been received so far.
  receivedQuantity Decimal   @default(0) @db.Decimal(18, 3)
  /// Transfer receives: the send line it takes from.
  sendLineId       String?   @db.Uuid

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])
  batch    Batch?        @relation(fields: [batchId], references: [id])

  @@index([documentId])
}

/// Stock history: one line per item, location and movement. Append-only
/// (trigger); only the re-costing routine may rewrite the derived figures.
model StockLedgerEntry {
  id             BigInt         @id @default(autoincrement())
  companyId      String         @db.Uuid
  itemId         String         @db.Uuid
  locationId     String         @db.Uuid
  batchId        String?        @db.Uuid
  /// stock_document, goods_receipt or landed_charge (module 5).
  documentType   String         @default("stock_document")
  documentId     String         @db.Uuid
  documentLineId String         @db.Uuid
  postingDate    DateTime       @db.Date
  postingAt      DateTime
  kind           StockEntryKind
  /// Intent: quantity in/out (basic units), incoming cost, count target, reversal of.
  intentQuantity Decimal        @db.Decimal(18, 3)
  incomingCost   Decimal?       @db.Decimal(16, 4)
  targetCost     Decimal?       @db.Decimal(16, 4)
  /// Takes its cost from this entry (transfers and moves).
  costSourceId   BigInt?
  reversesId     BigInt?
  /// Derived (rewritten by re-costing).
  quantityChange Decimal        @db.Decimal(18, 3)
  valueChange    Decimal        @db.Decimal(16, 2)
  unitCost       Decimal        @db.Decimal(16, 4)
  quantityAfter  Decimal        @db.Decimal(18, 3)
  unitCostAfter  Decimal        @db.Decimal(16, 4)
  valueAfter     Decimal        @db.Decimal(16, 2)
  /// What module 7 posts the value against (stock account on the other side).
  accountRole    String
  isCancellation Boolean        @default(false)
  /// Quantity went below zero (only the till may do this; reported daily).
  wentNegative   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  createdById    String?        @db.Uuid

  @@index([itemId, locationId, postingAt, id])
  @@index([documentId])
  @@index([costSourceId])
  @@index([postingDate])
}

/// Current stock per item × location. Always equals the sum of the ledger.
model StockPosition {
  itemId        String    @db.Uuid
  locationId    String    @db.Uuid
  companyId     String    @db.Uuid
  quantity      Decimal   @default(0) @db.Decimal(18, 3)
  unitCost      Decimal   @default(0) @db.Decimal(16, 4)
  value         Decimal   @default(0) @db.Decimal(16, 2)
  lastPostingAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@id([itemId, locationId])
  @@index([locationId])
}

model Batch {
  id              String    @id @default(uuid()) @db.Uuid
  itemId          String    @db.Uuid
  batchNumber     String
  manufactureDate DateTime? @db.Date
  expiryDate      DateTime? @db.Date
  supplierId      String?   @db.Uuid
  active          Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  item      Item                @relation(fields: [itemId], references: [id])
  lines     StockDocumentLine[]
  positions BatchPosition[]

  @@unique([itemId, batchNumber])
}

/// Quantity of a batch in a location (values are kept per item, decision 34).
model BatchPosition {
  batchId    String   @db.Uuid
  locationId String   @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt  DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id])

  @@id([batchId, locationId])
}

model SerialNumber {
  id            String       @id @default(uuid()) @db.Uuid
  itemId        String       @db.Uuid
  serial        String
  status        SerialStatus
  locationId    String?      @db.Uuid
  batchId       String?      @db.Uuid
  inDocumentId  String?      @db.Uuid
  outDocumentId String?      @db.Uuid
  warrantyUntil DateTime?    @db.Date

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([itemId, serial])
  @@index([locationId])
}

model ReorderLevel {
  id          String  @id @default(uuid()) @db.Uuid
  itemId      String  @db.Uuid
  storeId     String  @db.Uuid
  level       Decimal @db.Decimal(18, 3)
  quantity    Decimal @db.Decimal(18, 3)
  /// buy (purchase request) or move (from another store); used by module 5.
  requestType String  @default("buy")
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([itemId, storeId])
}

/// One row per company.
model InventorySettings {
  companyId           String    @id @db.Uuid
  /// Month-end lock (decision 36): nothing on or before this date.
  stockLockDate       DateTime? @db.Date
  /// Decision 32: the till may sell below zero (flagged); used by module 6.
  allowNegativeAtTill Boolean   @default(true)
  batchPickOrder      String    @default("earliest_expiry")
  transitLocationId   String?   @db.Uuid

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// Module 5 — Purchasing (plan 05). Values and account roles are stored on the
// lines; module 7 posts them to the books (plan 05 answer 1). GST is recorded
// as stated on the supplier's document (answer 2). Rupees only (answer 6).
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  draft
  to_receive_and_bill
  to_receive
  to_bill
  completed
  on_hold
  closed
  cancelled
}

enum GoodsReceiptStatus {
  draft
  to_bill
  partly_billed
  completed
  returned
  closed
  cancelled
}

enum SupplierBillStatus {
  draft
  unpaid
  cancelled
}

enum SupplierBillKind {
  against_receipt
  receives_goods
  services
  debit_note
}

enum PurchaseDocStatus {
  draft
  finalised
  cancelled
}

model PurchaseOrder {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  number             String               @unique
  supplierId         String               @db.Uuid
  /// Indian business dates (rule 15).
  orderDate          DateTime             @db.Date
  neededBy           DateTime             @db.Date
  storeId            String               @db.Uuid
  supplierQuoteRef   String?
  paymentTermsId     String?              @db.Uuid
  dueDate            DateTime?            @db.Date
  status             PurchaseOrderStatus  @default(draft)
  /// The status to return to when a hold is released.
  statusBeforeHold   PurchaseOrderStatus?
  taxableAmount      Decimal              @default(0) @db.Decimal(16, 2)
  taxAmount          Decimal              @default(0) @db.Decimal(16, 2)
  roundingAdjustment Decimal              @default(0) @db.Decimal(16, 2)
  total              Decimal              @default(0) @db.Decimal(16, 2)
  receivedPercent    Decimal              @default(0) @db.Decimal(5, 2)
  billedPercent      Decimal              @default(0) @db.Decimal(5, 2)
  /// Set when the total was above the approval limit (decision 69).
  approvedById       String?              @db.Uuid
  holdReason         String?
  closeReason        String?
  remarks            String?
  finalisedAt        DateTime?
  finalisedById      String?              @db.Uuid
  cancelledAt        DateTime?
  cancelledById      String?              @db.Uuid
  cancelReason       String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  store    Store               @relation(fields: [storeId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([companyId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @db.Uuid
  lineNo           Int
  itemId           String   @db.Uuid
  unitId           String   @db.Uuid
  factor           Decimal  @db.Decimal(18, 6)
  /// Charged quantity in the line unit; free units are extra (decision 27).
  quantity         Decimal  @db.Decimal(18, 3)
  freeQuantity     Decimal  @default(0) @db.Decimal(18, 3)
  /// (quantity + free) × factor.
  basicQuantity    Decimal  @db.Decimal(18, 3)
  rate             Decimal  @db.Decimal(16, 4)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(16, 2)
  taxableAmount    Decimal  @db.Decimal(16, 2)
  gstRate          Decimal  @default(0) @db.Decimal(5, 2)
  cgst             Decimal  @default(0) @db.Decimal(16, 2)
  sgst             Decimal  @default(0) @db.Decimal(16, 2)
  igst             Decimal  @default(0) @db.Decimal(16, 2)
  lineTotal        Decimal  @db.Decimal(16, 2)
  storeId          String   @db.Uuid
  neededBy         DateTime @db.Date
  /// Basic units received so far (accepted + rejected, net of returns).
  receivedQuantity Decimal  @default(0) @db.Decimal(18, 3)
  /// Taxable amount billed so far.
  billedAmount     Decimal  @default(0) @db.Decimal(16, 2)

  order        PurchaseOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item         Item                @relation(fields: [itemId], references: [id])
  receiptLines GoodsReceiptLine[]
  billLines    SupplierBillLine[]
  suggestions  ReorderSuggestion[]

  @@index([orderId])
  @@index([itemId])
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @db.Uuid
  number          String             @unique
  supplierId      String             @db.Uuid
  storeId         String             @db.Uuid
  postingDate     DateTime           @db.Date
  postingAt       DateTime
  deliveryNoteNo  String?
  transporterName String?
  vehicleNo       String?
  /// Decision 31: why goods were taken without an order.
  noOrderReason   String?
  status          GoodsReceiptStatus @default(draft)
  isReturn        Boolean            @default(false)
  returnOfId      String?            @db.Uuid
  /// Set when a bill that also receives the goods made this receipt.
  billId          String?            @db.Uuid
  taxableAmount   Decimal            @default(0) @db.Decimal(16, 2)
  taxAmount       Decimal            @default(0) @db.Decimal(16, 2)
  total           Decimal            @default(0) @db.Decimal(16, 2)
  /// Value that went into stock (accepted + rejected, after charges).
  stockValue      Decimal            @default(0) @db.Decimal(16, 2)
  billedPercent   Decimal            @default(0) @db.Decimal(5, 2)
  returnedPercent Decimal            @default(0) @db.Decimal(5, 2)
  /// Decision 29: the received-goods check.
  checkedById     String?            @db.Uuid
  checkedAt       DateTime?
  checkResult     String?
  checkRemarks    String?
  isBackDated     Boolean            @default(false)
  remarks         String?
  finalisedAt     DateTime?
  finalisedById   String?            @db.Uuid
  cancelledAt     DateTime?
  cancelledById   String?            @db.Uuid
  cancelReason    String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  supplier Supplier           @relation(fields: [supplierId], references: [id])
  store    Store              @relation(fields: [storeId], references: [id])
  returnOf GoodsReceipt?      @relation("receiptReturns", fields: [returnOfId], references: [id])
  returns  GoodsReceipt[]     @relation("receiptReturns")
  lines    GoodsReceiptLine[]

  @@index([companyId, status])
  @@index([supplierId])
}

model GoodsReceiptLine {
  id                       String    @id @default(uuid()) @db.Uuid
  receiptId                String    @db.Uuid
  lineNo                   Int
  orderLineId              String?   @db.Uuid
  itemId                   String    @db.Uuid
  unitId                   String    @db.Uuid
  factor                   Decimal   @db.Decimal(18, 6)
  /// In the line unit; received = accepted + rejected; free is part of received.
  receivedQuantity         Decimal   @db.Decimal(18, 3)
  acceptedQuantity         Decimal   @db.Decimal(18, 3)
  rejectedQuantity         Decimal   @default(0) @db.Decimal(18, 3)
  freeQuantity             Decimal   @default(0) @db.Decimal(18, 3)
  basicAcceptedQuantity    Decimal   @db.Decimal(18, 3)
  basicRejectedQuantity    Decimal   @default(0) @db.Decimal(18, 3)
  rate                     Decimal   @db.Decimal(16, 4)
  discountPercent          Decimal   @default(0) @db.Decimal(5, 2)
  discountAmount           Decimal   @default(0) @db.Decimal(16, 2)
  taxableAmount            Decimal   @db.Decimal(16, 2)
  gstRate                  Decimal   @default(0) @db.Decimal(5, 2)
  cgst                     Decimal   @default(0) @db.Decimal(16, 2)
  sgst                     Decimal   @default(0) @db.Decimal(16, 2)
  igst                     Decimal   @default(0) @db.Decimal(16, 2)
  lineTotal                Decimal   @db.Decimal(16, 2)
  /// Extra charges shared onto this line (landed cost).
  extraCharges             Decimal   @default(0) @db.Decimal(16, 2)
  /// Per basic unit, before GST, after free goods and charges.
  unitCost                 Decimal   @default(0) @db.Decimal(16, 4)
  shelfLocationId          String    @db.Uuid
  rejectedLocationId       String?   @db.Uuid
  batchId                  String?   @db.Uuid
  newBatchNumber           String?
  newManufactureOn         DateTime? @db.Date
  newExpiryOn              DateTime? @db.Date
  serialNumbers            String[]
  rejectedSerialNumbers    String[]
  /// Basic units billed / returned so far against this line.
  billedQuantity           Decimal   @default(0) @db.Decimal(18, 3)
  returnedAcceptedQuantity Decimal   @default(0) @db.Decimal(18, 3)
  returnedRejectedQuantity Decimal   @default(0) @db.Decimal(18, 3)
  /// Return lines: the line they take back.
  returnOfLineId           String?   @db.Uuid

  receipt   GoodsReceipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine?  @relation(fields: [orderLineId], references: [id])
  item      Item                @relation(fields: [itemId], references: [id])
  billLines SupplierBillLine[]
  shares    LandedChargeShare[]

  @@index([receiptId])
  @@index([orderLineId])
}

model SupplierBill {
  id                           String             @id @default(uuid()) @db.Uuid
  companyId                    String             @db.Uuid
  number                       String             @unique
  supplierId                   String             @db.Uuid
  kind                         SupplierBillKind
  /// The supplier's own number and date; unique per supplier per financial year.
  supplierBillNo               String
  supplierBillDate             DateTime           @db.Date
  postingDate                  DateTime           @db.Date
  postingAt                    DateTime
  financialYearId              String             @db.Uuid
  storeId                      String?            @db.Uuid
  paymentTermsId               String?            @db.Uuid
  dueDate                      DateTime           @db.Date
  status                       SupplierBillStatus @default(draft)
  holdReason                   String?
  holdUntil                    DateTime?          @db.Date
  taxableAmount                Decimal            @default(0) @db.Decimal(16, 2)
  taxAmount                    Decimal            @default(0) @db.Decimal(16, 2)
  roundingAdjustment           Decimal            @default(0) @db.Decimal(16, 2)
  total                        Decimal            @default(0) @db.Decimal(16, 2)
  /// Bill price minus receipt price over all lines (plan 05 answer 4).
  priceDifference              Decimal            @default(0) @db.Decimal(16, 2)
  priceDifferenceConfirmedById String?            @db.Uuid
  /// Debit notes: the bill they reduce.
  returnOfId                   String?            @db.Uuid
  /// Bills that receive goods: the receipt made for them.
  receiptId                    String?            @db.Uuid
  remarks                      String?
  finalisedAt                  DateTime?
  finalisedById                String?            @db.Uuid
  cancelledAt                  DateTime?
  cancelledById                String?            @db.Uuid
  cancelReason                 String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  supplier Supplier           @relation(fields: [supplierId], references: [id])
  returnOf SupplierBill?      @relation("billReturns", fields: [returnOfId], references: [id])
  returns  SupplierBill[]     @relation("billReturns")
  lines    SupplierBillLine[]

  @@index([companyId, status])
  @@index([supplierId, supplierBillNo])
}

model SupplierBillLine {
  id               String  @id @default(uuid()) @db.Uuid
  billId           String  @db.Uuid
  lineNo           Int
  receiptLineId    String? @db.Uuid
  orderLineId      String? @db.Uuid
  itemId           String  @db.Uuid
  unitId           String  @db.Uuid
  factor           Decimal @db.Decimal(18, 6)
  quantity         Decimal @db.Decimal(18, 3)
  freeQuantity     Decimal @default(0) @db.Decimal(18, 3)
  basicQuantity    Decimal @db.Decimal(18, 3)
  rate             Decimal @db.Decimal(16, 4)
  discountPercent  Decimal @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal @default(0) @db.Decimal(16, 2)
  taxableAmount    Decimal @db.Decimal(16, 2)
  gstRate          Decimal @default(0) @db.Decimal(5, 2)
  cgst             Decimal @default(0) @db.Decimal(16, 2)
  sgst             Decimal @default(0) @db.Decimal(16, 2)
  igst             Decimal @default(0) @db.Decimal(16, 2)
  lineTotal        Decimal @db.Decimal(16, 2)
  /// Taxable amount on the bill minus the receipt's for the same quantity.
  priceDifference  Decimal @default(0) @db.Decimal(16, 2)
  /// goods_received_not_billed, stock or purchase_expense (module 7 posts it).
  accountRole      String
  /// Debit notes: the bill line they reduce; and how much was already returned from a bill line.
  returnOfLineId   String? @db.Uuid
  returnedQuantity Decimal @default(0) @db.Decimal(18, 3)

  bill        SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  receiptLine GoodsReceiptLine?  @relation(fields: [receiptLineId], references: [id])
  orderLine   PurchaseOrderLine? @relation(fields: [orderLineId], references: [id])
  item        Item               @relation(fields: [itemId], references: [id])

  @@index([billId])
  @@index([receiptLineId])
}

model LandedCharge {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  number            String            @unique
  postingDate       DateTime          @db.Date
  status            PurchaseDocStatus @default(draft)
  /// quantity, value or manual.
  shareBy           String
  transporterBillId String?           @db.Uuid
  total             Decimal           @db.Decimal(16, 2)
  receiptIds        String[]          @db.Uuid
  remarks           String?
  finalisedAt       DateTime?
  finalisedById     String?           @db.Uuid
  cancelledAt       DateTime?
  cancelledById     String?           @db.Uuid
  cancelReason      String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  items  LandedChargeItem[]
  shares LandedChargeShare[]

  @@index([companyId, status])
}

model LandedChargeItem {
  id          String  @id @default(uuid()) @db.Uuid
  chargeId    String  @db.Uuid
  lineNo      Int
  description String
  /// freight, loading, insurance or other (module 7 maps them to accounts).
  chargeType  String
  amount      Decimal @db.Decimal(16, 2)

  charge LandedCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
}

model LandedChargeShare {
  id            String  @id @default(uuid()) @db.Uuid
  chargeId      String  @db.Uuid
  receiptLineId String  @db.Uuid
  amount        Decimal @db.Decimal(16, 2)

  charge      LandedCharge     @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  receiptLine GoodsReceiptLine @relation(fields: [receiptLineId], references: [id])

  @@unique([chargeId, receiptLineId])
}

model ReorderSuggestion {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  storeId           String   @db.Uuid
  itemId            String   @db.Uuid
  supplierId        String?  @db.Uuid
  onHand            Decimal  @db.Decimal(18, 3)
  onOrder           Decimal  @db.Decimal(18, 3)
  reorderLevel      Decimal  @db.Decimal(18, 3)
  reorderQuantity   Decimal  @db.Decimal(18, 3)
  suggestedQuantity Decimal  @db.Decimal(18, 3)
  /// Indian business date the suggestion was made for (rule 15).
  businessDate      DateTime @db.Date
  /// open, ordered or dismissed.
  status            String   @default("open")
  orderLineId       String?  @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  orderLine PurchaseOrderLine? @relation(fields: [orderLineId], references: [id])

  @@index([companyId, status])
  @@index([storeId, itemId])
}

model PurchaseSettings {
  companyId              String  @id @db.Uuid
  /// Decision 31: receipts without an order are allowed (with a reason) unless this is on.
  requireOrderForReceipt Boolean @default(false)
  overOrderPercent       Decimal @default(0) @db.Decimal(5, 2)
  overReceiptPercent     Decimal @default(0) @db.Decimal(5, 2)
  overBillingPercent     Decimal @default(0) @db.Decimal(5, 2)
  /// allow, warn or block (plan 05 answer 4: warn).
  priceMismatch          String  @default("warn")
  checkSupplierBillNo    Boolean @default(true)
  /// Decision 69 / plan 05 answer 3: ₹50,000.
  approvalLimit          Decimal @default(50000) @db.Decimal(16, 2)
  fillLastPurchasePrice  Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}
