// Copyright (c) 2026, Rademics. All rights reserved.
// Database schema. Change it only through `pnpm --filter api prisma migrate dev`
// and commit the generated migration in prisma/migrations.
// Module 1: users, roles, permissions, company, stores, financial years,
// document numbering, sessions and audit history (docs/plans/01-users-company-stores.md).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Company and stores
// ---------------------------------------------------------------------------

model Company {
  id                   String    @id @default(uuid()) @db.Uuid
  code                 String    @unique
  legalName            String
  tradeName            String?
  pan                  String?
  stateCode            String
  addressLine1         String?
  addressLine2         String?
  city                 String?
  pincode              String?
  phone                String?
  email                String?
  logo                 Bytes?
  logoMimeType         String?
  homeCurrency         String    @default("INR")
  fiscalYearStartMonth Int       @default(4)
  /// Set by the accounting module; nothing is dated on or before it.
  lockDate             DateTime? @db.Date
  /// Plan 12: the shop type chosen at setup (fancy, clothing, footwear, cosmetics, mobiles, general).
  shopType             String?
  /// Plan 12: the owner hid the getting-started checklist.
  checklistHidden      Boolean   @default(false)
  /// Module 10: the day the shop went live; once set, trial data can never be cleared (decision 72).
  goLiveDate           DateTime? @db.Date
  goLiveById           String?   @db.Uuid
  active               Boolean   @default(true)
  /// Plan 14: when the owner finished the setup wizard; until then the shop shows the wizard.
  setupCompletedAt     DateTime?
  /// Plan 14: the end of the free trial of a shop that signed up; empty for shops on a plan.
  trialEndsAt          DateTime?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  users             User[]
  sessions          Session[]
  userTokens        UserToken[]
  gstRegistrations  GstRegistration[]
  stores            Store[]
  financialYears    FinancialYear[]
  numberSeries      NumberSeries[]
  priceLists        PriceList[]
  catalogueSettings CatalogueSettings?
  customers         Customer[]
  suppliers         Supplier[]
  partySettings     PartySettings?
  stockLocations    StockLocation[]
}

model GstRegistration {
  id                     String  @id @default(uuid()) @db.Uuid
  companyId              String  @db.Uuid
  gstin                  String
  stateCode              String
  legalNameOnCertificate String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  pincode                String?
  isDefault              Boolean @default(false)
  active                 Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  stores  Store[]

  @@unique([companyId, gstin])
  @@index([companyId])
}

model Store {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  code              String
  name              String
  addressLine1      String?
  addressLine2      String?
  city              String?
  pincode           String?
  stateCode         String?
  /// Plan 11 B4 (decision 47): delivery charge on a home-delivery bill; none at or above deliveryFreeAbove.
  deliveryCharge    Decimal  @default(0) @db.Decimal(16, 2)
  deliveryFreeAbove Decimal? @db.Decimal(16, 2)
  phone             String?
  email             String?
  gstRegistrationId String?  @db.Uuid
  active            Boolean  @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id])
  gstRegistration GstRegistration? @relation(fields: [gstRegistrationId], references: [id])
  userStores      UserStore[]
  numberSeries    NumberSeries[]
  stockLocations  StockLocation[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  tills           Till[]

  @@unique([companyId, code])
}

enum FinancialYearStatus {
  open
  locked
}

model FinancialYear {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  name                 String
  startDate            DateTime            @db.Date
  endDate              DateTime            @db.Date
  /// A short or long first/bridging year that is not exactly twelve months.
  isIrregular          Boolean             @default(false)
  status               FinancialYearStatus @default(open)
  createdAutomatically Boolean             @default(false)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId, startDate])
}

// ---------------------------------------------------------------------------
// Document numbering
// ---------------------------------------------------------------------------

model NumberSeries {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  documentKind  String
  /// Prefix pattern with tokens, e.g. "INV-{STORE}-{FY}-".
  pattern       String
  counterLength Int     @default(5)
  /// Null = applies to every store without its own series.
  storeId       String? @db.Uuid
  active        Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  company  Company               @relation(fields: [companyId], references: [id])
  store    Store?                @relation(fields: [storeId], references: [id])
  counters NumberSeriesCounter[]

  @@unique([companyId, documentKind, storeId])
  /// PostgreSQL treats nulls as different, so the rule above never stops two
  /// company-wide series for the same document kind; this one does.
  @@unique([companyId, documentKind], where: raw("\"storeId\" IS NULL"), map: "NumberSeries_companyId_documentKind_company_wide_key")
}

/// One running number per filled-in prefix; locked row-by-row when allocating.
model NumberSeriesCounter {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId      String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id             String @id @default(uuid()) @db.Uuid
  numberSeriesId String @db.Uuid
  filledPrefix   String
  nextNumber     Int    @default(1)

  updatedAt DateTime @updatedAt

  numberSeries NumberSeries @relation(fields: [numberSeriesId], references: [id])

  @@unique([numberSeriesId, filledPrefix])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Users, roles, sessions
// ---------------------------------------------------------------------------

model User {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId          String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  firstName          String
  lastName           String?
  mobile             String?
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime  @default(now())
  active             Boolean   @default(true)
  /// True = may work in every store; otherwise limited to UserStore rows.
  allStores          Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// When the person confirmed their email by its link (owner, 26 October 2026); null = not yet.
  emailVerifiedAt    DateTime?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  roles    UserRole[]
  stores   UserStore[]
  sessions Session[]
  tokens   UserToken[]
  company  Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Role {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId   String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id          String  @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  /// Seeded roles cannot be deleted or renamed in code; their permissions can be edited.
  isSystem    Boolean @default(false)
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@index([companyId])
}

model RolePermission {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId     String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  roleId        String @db.Uuid
  permissionKey String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([companyId])
}

model UserRole {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  userId    String @db.Uuid
  roleId    String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([companyId])
}

model UserStore {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  userId    String  @db.Uuid
  storeId   String  @db.Uuid
  isDefault Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
  @@index([companyId])
}

/// A one-time link sent by email (owner, 26 October 2026): "choose a new password" or
/// "confirm your email". Only a hash of the link is kept; it works once, until it expires.
model UserToken {
  /// The shop this row belongs to (filled in by the database from the request's shop).
  companyId String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// "password_reset" or "email_confirm"
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId, purpose])
  @@index([companyId])
}

model Session {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId    String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
}

/// Single-row table of security settings.
model SecuritySettings {
  /// Plan 14: one row per shop.
  companyId            String  @id @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  minPasswordLength    Int     @default(10)
  lockoutAttempts      Int     @default(5)
  lockoutSeconds       Int     @default(900)
  sessionIdleMinutes   Int     @default(30)
  sessionMaxHours      Int     @default(12)
  singleSessionPerUser Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// History (append-only; UPDATE and DELETE are refused by a database trigger
// created in the migration)
// ---------------------------------------------------------------------------

model AuditLog {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId  String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// { field: { old, new } } for changes; free-form details for other actions.
  changes    Json?
  reason     String?
  ipAddress  String?

  @@index([entityType, entityId])
  @@index([userId, at])
  @@index([at])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Module 2: catalogue (docs/plans/02-items-units-barcodes-price-lists.md)
// Units, groups, brands, HSN codes and attributes are shared by all companies;
// price lists and catalogue settings belong to a company.
// ---------------------------------------------------------------------------

enum UnitKind {
  count
  weight
  length
  volume
  other
}

model Unit {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId       String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id              String   @id @default(uuid()) @db.Uuid
  code            String
  name            String
  kind            UnitKind
  /// Decision 11: may be true only for weight, length and volume.
  allowsFractions Boolean  @default(false)
  active          Boolean  @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  conversionsFrom UnitConversion[] @relation("fromUnit")
  conversionsTo   UnitConversion[] @relation("toUnit")
  itemsAsBase     Item[]
  itemUnits       ItemUnit[]
  barcodes        Barcode[]
  prices          Price[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Standard conversion stored once: 1 fromUnit = factor toUnit (1 KG = 1000 G).
model UnitConversion {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId  String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id         String  @id @default(uuid()) @db.Uuid
  fromUnitId String  @db.Uuid
  toUnitId   String  @db.Uuid
  factor     Decimal @db.Decimal(18, 6)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  fromUnit Unit @relation("fromUnit", fields: [fromUnitId], references: [id])
  toUnit   Unit @relation("toUnit", fields: [toUnitId], references: [id])

  @@unique([fromUnitId, toUnitId])
  @@index([companyId])
}

model ItemGroup {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String  @id @default(uuid()) @db.Uuid
  parentId  String? @db.Uuid
  code      String
  name      String
  /// "/id-of-root/id-of-child/" for subtree queries.
  path      String
  depth     Int     @default(0)
  hsnCode   String?
  active    Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent   ItemGroup?  @relation("groupTree", fields: [parentId], references: [id])
  children ItemGroup[] @relation("groupTree")
  items    Item[]

  @@unique([companyId, code])
  @@index([path])
  @@index([companyId])
}

model Brand {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String  @id @default(uuid()) @db.Uuid
  code      String
  name      String
  active    Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  items Item[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// HSN (goods) and SAC (services) codes; the GST rate per code comes with the GST module.
model HsnCode {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId   String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id          String  @id @default(uuid()) @db.Uuid
  code        String
  description String
  isService   Boolean @default(false)
  active      Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([companyId, code])
  @@index([companyId])
}

enum AttributeKind {
  list
  numeric
}

model VariantAttribute {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId  String        @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id         String        @id @default(uuid()) @db.Uuid
  code       String
  name       String
  kind       AttributeKind @default(list)
  rangeStart Decimal?      @db.Decimal(12, 4)
  rangeEnd   Decimal?      @db.Decimal(12, 4)
  rangeStep  Decimal?      @db.Decimal(12, 4)
  active     Boolean       @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  values         VariantAttributeValue[]
  itemAttributes ItemVariantAttribute[]
  itemValues     ItemVariantValue[]

  @@unique([companyId, code])
  @@index([companyId])
}

model VariantAttributeValue {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId   String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @db.Uuid
  value       String
  /// Lower-cased value for case-insensitive uniqueness.
  valueKey    String
  shortCode   String
  sortOrder   Int    @default(0)

  attribute VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, valueKey])
  @@unique([attributeId, shortCode])
  @@index([companyId])
}

enum BarcodeType {
  EAN13
  EAN8
  UPCA
  CODE39
  other
}

model Item {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId           String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id                  String    @id @default(uuid()) @db.Uuid
  code                String
  name                String
  description         String?
  image               Bytes?
  imageMimeType       String?
  itemGroupId         String    @db.Uuid
  brandId             String?   @db.Uuid
  /// Plan 11 C4: the season or collection the item belongs to.
  seasonId            String?   @db.Uuid
  baseUnitId          String    @db.Uuid
  hsnCode             String?
  /// Per basic unit (decision 76). Pack MRPs are on ItemUnit.
  mrp                 Decimal?  @db.Decimal(14, 2)
  maxDiscountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  isStockItem         Boolean   @default(true)
  canBuy              Boolean   @default(true)
  canSell             Boolean   @default(true)
  endDate             DateTime? @db.Date
  active              Boolean   @default(true)
  /// A style that only groups its variants; never stocked, priced or sold.
  isParentStyle       Boolean   @default(false)
  parentItemId        String?   @db.Uuid
  /// Sorted "attributeId=value|…" of a variant, unique within its parent.
  variantKey          String?
  trackBatches        Boolean   @default(false)
  autoNumberBatches   Boolean   @default(false)
  shelfLifeDays       Int?
  trackSerials        Boolean   @default(false)
  warrantyDays        Int?
  /// Per basic unit, filled by purchasing (module 5). Hidden without cost_price.view.
  lastPurchasePrice   Decimal?  @db.Decimal(16, 4)
  /// Filled by module 3 (suppliers).
  preferredSupplierId String?   @db.Uuid
  /// Module 5: overrides the company over-receipt / over-billing allowance (percent).
  overReceiptPercent  Decimal?  @db.Decimal(5, 2)
  /// Module 5: smallest total per order, in basic units.
  minOrderQuantity    Decimal?  @db.Decimal(18, 3)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  itemGroup          ItemGroup              @relation(fields: [itemGroupId], references: [id])
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  baseUnit           Unit                   @relation(fields: [baseUnitId], references: [id])
  parent             Item?                  @relation("variants", fields: [parentItemId], references: [id])
  variants           Item[]                 @relation("variants")
  units              ItemUnit[]
  barcodes           Barcode[]
  variantAttributes  ItemVariantAttribute[]
  variantValues      ItemVariantValue[]
  prices             Price[]
  preferredSupplier  Supplier?              @relation(fields: [preferredSupplierId], references: [id])
  stockLines         StockDocumentLine[]
  batches            Batch[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  supplierBillLines  SupplierBillLine[]
  posBillLines       PosBillLine[]

  @@unique([parentItemId, variantKey])
  @@unique([companyId, code])
  @@index([name])
  @@index([seasonId])
  @@index([itemGroupId])
  @@index([companyId])
}

/// Units an item is bought or sold in. The basic unit row always has factor 1.
model ItemUnit {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @db.Uuid
  unitId    String   @db.Uuid
  /// Basic units in one of this unit (BOX = 12 PCS → 12).
  factor    Decimal  @db.Decimal(18, 6)
  mrp       Decimal? @db.Decimal(14, 2)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, unitId])
  @@index([companyId])
}

model Barcode {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String      @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String      @id @default(uuid()) @db.Uuid
  code      String
  itemId    String      @db.Uuid
  unitId    String?     @db.Uuid
  type      BarcodeType @default(other)
  active    Boolean     @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
}

/// Which attributes a style varies by.
model ItemVariantAttribute {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId   String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  itemId      String @db.Uuid
  attributeId String @db.Uuid
  sortOrder   Int    @default(0)

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute VariantAttribute @relation(fields: [attributeId], references: [id])

  @@id([itemId, attributeId])
  @@index([companyId])
}

/// A variant's value for each of its parent's attributes.
model ItemVariantValue {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId   String @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  itemId      String @db.Uuid
  attributeId String @db.Uuid
  value       String
  shortCode   String

  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attribute VariantAttribute @relation(fields: [attributeId], references: [id])

  @@id([itemId, attributeId])
  @@index([companyId])
}

model PriceList {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  code          String
  name          String
