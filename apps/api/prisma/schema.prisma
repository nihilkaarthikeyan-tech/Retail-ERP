  rejectedQuantity         Decimal   @default(0) @db.Decimal(18, 3)
  freeQuantity             Decimal   @default(0) @db.Decimal(18, 3)
  basicAcceptedQuantity    Decimal   @db.Decimal(18, 3)
  basicRejectedQuantity    Decimal   @default(0) @db.Decimal(18, 3)
  rate                     Decimal   @db.Decimal(16, 4)
  discountPercent          Decimal   @default(0) @db.Decimal(5, 2)
