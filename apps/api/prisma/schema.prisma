  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, clientId])
  @@index([companyId])
}

model ShiftClosing {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId     String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id            String   @id @default(uuid()) @db.Uuid
  shiftId       String   @unique @db.Uuid
  closedById    String   @db.Uuid
  closedAt      DateTime
  denominations Json
  remarks       String?
  approvedById  String?  @db.Uuid
  bills         Int
  salesTotal    Decimal  @db.Decimal(16, 2)
  returnsTotal  Decimal  @db.Decimal(16, 2)
  taxableTotal  Decimal  @db.Decimal(16, 2)
  cgstTotal     Decimal  @db.Decimal(16, 2)
  sgstTotal     Decimal  @db.Decimal(16, 2)
  igstTotal     Decimal  @db.Decimal(16, 2)
  roundingTotal Decimal  @db.Decimal(16, 2)
  costTotal     Decimal  @db.Decimal(16, 2)
  /// Day-end summary by account role for module 7 (decision 39).
  summary       Json

  createdAt DateTime @default(now())

  shift Shift              @relation(fields: [shiftId], references: [id])
  lines ShiftClosingLine[]

  @@index([companyId])
}

model ShiftClosingLine {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId       String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id              String  @id @default(uuid()) @db.Uuid
  closingId       String  @db.Uuid
  paymentMethodId String  @db.Uuid
  opening         Decimal @db.Decimal(16, 2)
  expected        Decimal @db.Decimal(16, 2)
  counted         Decimal @db.Decimal(16, 2)
  difference      Decimal @db.Decimal(16, 2)

  closing ShiftClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model PosBill {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  tillId             String        @db.Uuid
  shiftId            String        @db.Uuid
  number             String
  /// Idempotency (pos-offline §4): one bill per till + client id + kind.
  clientId           String        @db.Uuid
  kind               PosBillKind
  returnOfId         String?       @db.Uuid
  /// A return and a sale made together on the exchange screen (decision 42).
  exchangeId         String?       @db.Uuid
  customerId         String        @db.Uuid
  cashierId          String        @db.Uuid
  /// Plan 11 C1: the salesperson for the bill (each line may name its own).
  salesStaffId       String?       @db.Uuid
  soldAt             DateTime
  businessDate       DateTime      @db.Date
  status             PosBillStatus @default(completed)
  grossAmount        Decimal       @db.Decimal(16, 2)
  discountAmount     Decimal       @db.Decimal(16, 2)
  taxableAmount      Decimal       @db.Decimal(16, 2)
  cgst               Decimal       @db.Decimal(16, 2)
  sgst               Decimal       @db.Decimal(16, 2)
  igst               Decimal       @db.Decimal(16, 2)
  roundingAdjustment Decimal       @db.Decimal(16, 2)
  total              Decimal       @db.Decimal(16, 2)
  paidAmount         Decimal       @db.Decimal(16, 2)
  changeAmount       Decimal       @default(0) @db.Decimal(16, 2)
  costValue          Decimal       @default(0) @db.Decimal(16, 2)
  couponId           String?       @db.Uuid
  billDiscount       Decimal       @default(0) @db.Decimal(16, 2)
  offline            Boolean       @default(false)
  /// price_changed, offer_changed, gst_changed, stock_negative, expired_batch, before_lock …
  checkFlags         String[]
  /// Only bills saved before 22 Oct 2026 (or returns of them) can be provisional.
  gstProvisional     Boolean       @default(false)
  /// Plan 08: consumer, business (B2B tax invoice) or bill_of_supply (composition).
  invoiceKind        String        @default("consumer")
  buyerGstin         String?
  buyerName          String?
  buyerAddress       String?
  buyerStateCode     String?
  /// Plan 08 G1: the state code of the place of supply.
  placeOfSupply      String?
  /// The GST registration the bill is reported under.
  gstRegistrationId  String?       @db.Uuid
  returnReason       String?
  approvedById       String?       @db.Uuid
  cancelledAt        DateTime?
  cancelledById      String?       @db.Uuid
  cancelReason       String?
  reprints           Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  till     Till          @relation(fields: [tillId], references: [id])
  shift    Shift         @relation(fields: [shiftId], references: [id])
  returnOf PosBill?      @relation("posReturns", fields: [returnOfId], references: [id])
  returns  PosBill[]     @relation("posReturns")
  lines    PosBillLine[]
  payments PosPayment[]

  @@unique([tillId, clientId, kind])
  @@unique([companyId, number])
  @@index([shiftId])
  @@index([companyId, businessDate])
}

model PosBillLine {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId        String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id               String   @id @default(uuid()) @db.Uuid
  billId           String   @db.Uuid
  lineNo           Int
  itemId           String   @db.Uuid
  unitId           String   @db.Uuid
  factor           Decimal  @db.Decimal(18, 6)
  /// Minus on returns.
  quantity         Decimal  @db.Decimal(18, 3)
  basicQuantity    Decimal  @db.Decimal(18, 3)
  barcode          String?
  batchId          String?  @db.Uuid
  serialNumbers    String[]
  mrp              Decimal? @db.Decimal(14, 2)
  listPrice        Decimal  @db.Decimal(16, 4)
  price            Decimal  @db.Decimal(16, 4)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  /// Manual + offer + share of the bill discount, in rupees.
  discountAmount   Decimal  @default(0) @db.Decimal(16, 2)
  offerDiscount    Decimal  @default(0) @db.Decimal(16, 2)
  offerId          String?  @db.Uuid
  /// Plan 11 C1: who sold this line; returns keep the original line's salesperson.
  salesStaffId     String?  @db.Uuid
  isFree           Boolean  @default(false)
  gstRate          Decimal  @db.Decimal(5, 2)
  /// Plan 08: the HSN code when sold, so reports stay stable if the item's code changes later.
  hsnCode          String?
  taxableAmount    Decimal  @db.Decimal(16, 2)
  cgst             Decimal  @db.Decimal(16, 2)
  sgst             Decimal  @db.Decimal(16, 2)
  igst             Decimal  @db.Decimal(16, 2)
  lineTotal        Decimal  @db.Decimal(16, 2)
  returnOfLineId   String?  @db.Uuid
  /// Sale lines: basic units returned so far.
  returnedQuantity Decimal  @default(0) @db.Decimal(18, 3)
  approvedById     String?  @db.Uuid
  costValue        Decimal  @default(0) @db.Decimal(16, 2)
  accountRole      String   @default("sales")

  bill PosBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  item Item    @relation(fields: [itemId], references: [id])

  @@index([billId])
  @@index([itemId])
  @@index([companyId])
}

model PosPayment {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId       String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id              String  @id @default(uuid()) @db.Uuid
  billId          String  @db.Uuid
  paymentMethodId String  @db.Uuid
  /// Minus on refunds.
  amount          Decimal @db.Decimal(16, 2)
  reference       String?

  bill          PosBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([companyId])
}

model Offer {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  code            String
  name            String
  /// percent, amount, special_price or free_goods.
  kind            String
  /// items, groups, brands or bill.
  appliesTo       String
  targetIds       String[]  @db.Uuid
  value           Decimal?  @db.Decimal(16, 4)
  buyQuantity     Decimal?  @db.Decimal(18, 3)
  freeQuantity    Decimal?  @db.Decimal(18, 3)
  /// Plan 11 B3: buy_get gives this item free; mix_match counts setQuantity items for setPrice, or the cheapest free.
  freeItemId      String?   @db.Uuid
  setQuantity     Int?
  setPrice        Decimal?  @db.Decimal(16, 2)
  cheapestFree    Boolean   @default(false)
  minQuantity     Decimal?  @db.Decimal(18, 3)
  minAmount       Decimal?  @db.Decimal(16, 2)
  storeIds        String[]  @db.Uuid
  customerGroupId String?   @db.Uuid
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  priority        Int       @default(0)
  couponOnly      Boolean   @default(false)
  active          Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  coupons Coupon[]

  @@unique([companyId, code])
}

model Coupon {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  code       String
  offerId    String    @db.Uuid
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  maxUses    Int?
  usedCount  Int       @default(0)
  customerId String?   @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([companyId, code])
}

model PosSettings {
  companyId                    String  @id @db.Uuid
  /// Plan 06 answer 6: a difference above this at closing needs a manager PIN.
  cashDifferenceApprovalAmount Decimal @default(100) @db.Decimal(16, 2)
  printReceiptCopies           Int     @default(1)
  /// Plan 06 answer 1: tills bill for real only once the Owner switches this on.
  liveAllowed                  Boolean @default(false)
  /// Plan 11 B4: the service item the delivery charge is billed as.
  deliveryItemId               String? @db.Uuid
  /// Plan 11 part 2: the service item alteration charges are billed as.
  alterationItemId             String? @db.Uuid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// A manager PIN approval (decision 40): single use, short-lived, kept for the history.
model PosApproval {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String    @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  tillId    String    @db.Uuid
  managerId String    @db.Uuid
  action    String
  details   String?
  expiresAt DateTime
  usedAt    DateTime?
  usedFor   String?

  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A cashier who switched in on a till with their PIN (decision 68).
model PosCashierToken {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  tillId    String   @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A transaction from a till that the server could not accept (pos-offline §5 "Sync problems").
model PosSyncProblem {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  tillId       String    @db.Uuid
  clientId     String    @db.Uuid
  kind         String
  payload      Json
  error        String
  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tillId, clientId, kind])
}

// ---------------------------------------------------------------------------
// Module 7: accounting (docs/plans/07-accounting.md). The ledger is the single
// source of truth (decision 51); posted lines are never changed (decision 50).
// ---------------------------------------------------------------------------

enum AccountFamily {
  asset
  liability
  equity
  income
  expense
}

enum AccountingDocStatus {
  draft
  posted
  cancelled
}

/// The chart of accounts: folders and bottom-level accounts in five families.
model Account {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  parentId      String?       @db.Uuid
  /// Optional account number, unique in the company.
  number        String?
  name          String
  isGroup       Boolean       @default(false)
  /// Inherited from the folder.
  family        AccountFamily
  /// How the system uses it: cash, bank, receivable, payable, stock, transit, grni, cogs, tax, rounding, temporary_opening, income, expense, equity, other. Null on folders.
  kind          String?
  /// Per-store accounts (cash in till, cash in hand).
  storeId       String?       @db.Uuid
  /// "debit" or "credit": the balance may never go the other way.
  balanceMustBe String?
  locked        Boolean       @default(false)
  active        Boolean       @default(true)
  /// Standard accounts the system creates, e.g. "sales", "cash_in_till:<storeId>".
  systemKey     String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parent   Account?         @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]        @relation("AccountTree")
  lines    LedgerLine[]
  defaults AccountDefault[]

  @@unique([companyId, number])
  @@unique([companyId, systemKey])
  @@index([companyId, parentId])
}

/// Which account each kind of money from the other modules posts to.
model AccountDefault {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  /// e.g. goods_received_not_billed, supplier_payable, sales, cost_of_goods_sold.
  role      String
  accountId String @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  account Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, role])
}

model AccountingSettings {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @unique @db.Uuid
  /// The Chartered Accountant's approval of the chart (decision 55), recorded by the Owner.
  chartApprovedAt   DateTime?
  chartApprovedById String?   @db.Uuid
  chartApprovalNote String?
  /// Age bands in days for unpaid bills.
  ageingBands       Int[]     @default([30, 60, 90, 120])

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// One posting. Never updated or deleted (database trigger).
model LedgerEntry {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  entryDate       DateTime @db.Date
  financialYearId String   @db.Uuid
  /// supplier_bill, goods_receipt, stock_document, landed_charge, pos_shift, pos_bill, journal, payment, opening_bill, year_end_closing.
  documentType    String
  documentId      String   @db.Uuid
  documentNumber  String?
  storeId         String?  @db.Uuid
  isOpening       Boolean  @default(false)
  /// Set on a reversal: the entry it cancels.
  cancelsId       String?  @unique @db.Uuid
  remark          String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  cancels     LedgerEntry? @relation("LedgerCancel", fields: [cancelsId], references: [id])
  cancelledBy LedgerEntry? @relation("LedgerCancel")
  lines       LedgerLine[]

  @@index([companyId, entryDate])
  @@index([documentType, documentId])
}

/// One debit or credit. Never updated or deleted (database trigger).
model LedgerLine {
  id         BigInt    @id @default(autoincrement())
  entryId    String    @db.Uuid
  companyId  String    @db.Uuid
  entryDate  DateTime  @db.Date
  accountId  String    @db.Uuid
  /// Store cost centre (required on income and expense lines).
  storeId    String?   @db.Uuid
  /// customer or supplier, on their balance accounts.
  partyType  String?
  partyId    String?   @db.Uuid
  debit      Decimal   @default(0) @db.Decimal(16, 2)
  credit     Decimal   @default(0) @db.Decimal(16, 2)
  /// The open item this party line belongs to (a bill, a payment, a credit note).
  itemType   String?
  itemId     String?   @db.Uuid
  itemNumber String?
  dueDate    DateTime? @db.Date
  remark     String?

  entry   LedgerEntry @relation(fields: [entryId], references: [id])
  account Account     @relation(fields: [accountId], references: [id])

  @@index([accountId, entryDate])
  @@index([companyId, entryDate])
  @@index([partyType, partyId, entryDate])
  @@index([itemType, itemId])
}

/// A link: how much of one open item (e.g. a payment) settles another (e.g. a bill). Undone links stay.
model Settlement {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  partyType  String
  partyId    String    @db.Uuid
  /// The item that owed (normally the bill).
  billType   String
  billId     String    @db.Uuid
  /// The item that settles it (payment, journal, credit note, return).
  byType     String
  byId       String    @db.Uuid
  amount     Decimal   @db.Decimal(16, 2)
  settledOn  DateTime  @db.Date
  undone     Boolean   @default(false)
  undoneAt   DateTime?
  undoneById String?   @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@index([partyType, partyId])
  @@index([billType, billId])
  @@index([byType, byId])
}

model Journal {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  number          String?
  /// general, cash, bank, contra, credit_note, debit_note, write_off, opening.
  kind            String
  journalDate     DateTime            @db.Date
  financialYearId String              @db.Uuid
  reference       String?
  referenceDate   DateTime?           @db.Date
  clearedOn       DateTime?           @db.Date
  remark          String?
  status          AccountingDocStatus @default(draft)
  ledgerEntryId   String?             @db.Uuid
  postedAt        DateTime?
  postedById      String?             @db.Uuid
  cancelledAt     DateTime?
  cancelledById   String?             @db.Uuid
  cancelReason    String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  lines JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, journalDate])
}

model JournalLine {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId   String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id          String  @id @default(uuid()) @db.Uuid
  journalId   String  @db.Uuid
  lineNo      Int
  accountId   String  @db.Uuid
  storeId     String? @db.Uuid
  partyType   String?
  partyId     String? @db.Uuid
  debit       Decimal @default(0) @db.Decimal(16, 2)
  credit      Decimal @default(0) @db.Decimal(16, 2)
  /// The open item this line settles (a bill of the same party).
  againstType String?
  againstId   String? @db.Uuid
  remark      String?

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Money received from a customer, paid to a supplier, or moved between own accounts.
model Payment {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  number          String?
  /// receipt, payment, transfer.
  kind            String
  paymentDate     DateTime            @db.Date
  financialYearId String              @db.Uuid
  storeId         String?             @db.Uuid
  partyType       String?
  partyId         String?             @db.Uuid
  /// Plan 11 part 2: an advance taken against a customer order.
  orderId         String?             @db.Uuid
  /// Receipt: to = cash or bank. Payment: from = cash or bank. Transfer: both.
  fromAccountId   String?             @db.Uuid
  toAccountId     String?             @db.Uuid
  amount          Decimal             @db.Decimal(16, 2)
  reference       String?
  referenceDate   DateTime?           @db.Date
  clearedOn       DateTime?           @db.Date
  remark          String?
  status          AccountingDocStatus @default(draft)
  ledgerEntryId   String?             @db.Uuid
  postedAt        DateTime?
  postedById      String?             @db.Uuid
  cancelledAt     DateTime?
  cancelledById   String?             @db.Uuid
  cancelReason    String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  allocations PaymentAllocation[]
  deductions  PaymentDeduction[]

  @@unique([companyId, number])
  @@index([companyId, paymentDate])
  @@index([partyType, partyId])
}

/// On a draft payment: which bills it will settle. Turned into Settlement links when posted.
model PaymentAllocation {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  billType  String
  billId    String  @db.Uuid
  amount    Decimal @db.Decimal(16, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Bank charges, card commission, a small short payment written off.
model PaymentDeduction {
  /// Plan 14: the shop this row belongs to (filled in by the database from the request's shop).
  companyId String  @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  accountId String  @db.Uuid
  amount    Decimal @db.Decimal(16, 2)
  remark    String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// An unpaid customer or supplier bill from before going live (against the temporary opening account).
model OpeningBill {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @db.Uuid
  partyType     String
  partyId       String              @db.Uuid
  storeId       String?             @db.Uuid
  billNumber    String
  billDate      DateTime            @db.Date
  dueDate       DateTime?           @db.Date
  amount        Decimal             @db.Decimal(16, 2)
  status        AccountingDocStatus @default(posted)
  ledgerEntryId String?             @db.Uuid
  cancelledAt   DateTime?
  cancelledById String?             @db.Uuid
  cancelReason  String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([partyType, partyId])
}

model BankAccount {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.Uuid
  accountId     String  @unique @db.Uuid
  bankName      String
  accountNumber String
  ifsc          String?
  branch        String?
  isDefault     Boolean @default(false)
  active        Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

model YearEndClosing {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @db.Uuid
  financialYearId  String              @db.Uuid
  closingAccountId String              @db.Uuid
  periodEnd        DateTime            @db.Date
  remark           String?
  status           AccountingDocStatus @default(posted)
  ledgerEntryId    String?             @db.Uuid
  cancelledAt      DateTime?
  cancelledById    String?             @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([companyId, periodEnd])
}

// ---------------------------------------------------------------------------
// Module 9: reports and dashboards (docs/plans/09-reports.md). Reports only
// read; these tables hold the owner's daily summary email (decision 67).
// ---------------------------------------------------------------------------

model SummaryEmailSettings {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @unique @db.Uuid
  enabled      Boolean  @default(false)
  /// Indian time, HH:MM.
  sendAt       String   @default("21:00")
  recipientIds String[] @db.Uuid
  figures      String[]

