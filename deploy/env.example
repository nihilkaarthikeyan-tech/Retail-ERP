# Copy to deploy/.env on the server (chmod 600, owned by root) and fill in.
# Never commit the real file.

# The address people open in the browser (no slash at the end).
PUBLIC_URL=https://retailerp.52digit.com

# Database inside Docker. Use a long random password.
POSTGRES_USER=retail_erp
POSTGRES_PASSWORD=
POSTGRES_DB=retail_erp

# Ports on 127.0.0.1 that Nginx forwards to (must be free on the server).
WEB_HOST_PORT=4060
API_HOST_PORT=4061

# Optional: mail for the owner's daily summary email and the new-enquiry alert. Leave SMTP_HOST empty to switch it off.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Who gets an email for each new message from the landing page's contact form (comma-separated).
# Empty means editor.publicationmart@gmail.com.
LEAD_ALERT_TO=
